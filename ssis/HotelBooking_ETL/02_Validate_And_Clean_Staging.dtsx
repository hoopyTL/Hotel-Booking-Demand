<?xml version='1.0' encoding='utf-8'?>
<DTS:Executable xmlns:DTS="www.microsoft.com/SqlServer/Dts" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" DTS:refId="Package" DTS:CreationDate="11/17/2026 10:53:15 AM" DTS:CreationName="Microsoft.Package" DTS:CreatorComputerName="DESKTOP-29LD447" DTS:CreatorName="DESKTOP-29LD447\ADMIN" DTS:DTSID="{28467124-AB15-4075-86FD-038A37DBF3C6}" DTS:ExecutableType="Microsoft.Package" DTS:LastModifiedProductVersion="16.0.1000.6" DTS:LocaleID="1033" DTS:ObjectName="02_Validate_And_Clean_Staging" DTS:PackageType="5" DTS:VersionGUID="{BC0F207F-BEA9-58C5-A2CF-92DCD0E02968}" DTS:DelayValidation="True">
  <DTS:Property DTS:Name="PackageFormatVersion">8</DTS:Property>
  <DTS:PackageParameters>
    <DTS:PackageParameter DTS:CreationName="" DTS:DataType="3" DTS:DTSID="{C62AEE31-ADC8-4769-89CF-F26FB5A3730E}" DTS:ObjectName="SourceBatchId">
      <DTS:Property DTS:Name="ParameterValue" DTS:DataType="3">0</DTS:Property>
    </DTS:PackageParameter>
    <DTS:PackageParameter DTS:CreationName="" DTS:DataType="8" DTS:DTSID="{99C03C08-C457-4F6B-90C0-837C5826A0E5}" DTS:ObjectName="SqlConnectionString">
      <DTS:Property DTS:Name="ParameterValue" DTS:DataType="8">Data Source=.\SQLEXPRESS;Initial Catalog=HotelBooking_DW;Provider=MSOLEDBSQL;Integrated Security=SSPI;Trust Server Certificate=True;</DTS:Property>
    </DTS:PackageParameter>
  </DTS:PackageParameters>
  <DTS:Variables>
    <DTS:Variable DTS:DTSID="{C1476CBC-AA87-4B9F-BF95-290F860578C2}" DTS:Namespace="User" DTS:ObjectName="BatchId">
      <DTS:VariableValue DTS:DataType="3">0</DTS:VariableValue>
    </DTS:Variable>
    <DTS:Variable DTS:DTSID="{32C1188B-AD01-4868-93F7-B632DFA1C0C2}" DTS:Namespace="User" DTS:ObjectName="RunBatchId">
      <DTS:VariableValue DTS:DataType="3">0</DTS:VariableValue>
    </DTS:Variable>
    <DTS:Variable DTS:DTSID="{222570CC-CD08-5EE3-9569-E14975BB4040}" DTS:Namespace="User" DTS:ObjectName="RowsClean">
      <DTS:VariableValue DTS:DataType="3">0</DTS:VariableValue>
    </DTS:Variable>
    <DTS:Variable DTS:DTSID="{EAB4CE9F-96A0-5078-AFA3-CDA79BF2FD8D}" DTS:Namespace="User" DTS:ObjectName="RowsRejected">
      <DTS:VariableValue DTS:DataType="3">0</DTS:VariableValue>
    </DTS:Variable>
    <DTS:Variable DTS:DTSID="{1F8BF94B-241A-5499-B3B6-CE1CCA68EB93}" DTS:EvaluateAsExpression="True" DTS:Expression="&quot;WITH Base AS (SELECT r.staging_row_id, r.batch_id, HASHBYTES('SHA2_256', CONCAT_WS('|', r.hotel, r.is_canceled, r.lead_time, r.arrival_date_year, r.arrival_date_month, r.arrival_date_week_number, r.arrival_date_day_of_month, r.stays_in_weekend_nights, r.stays_in_week_nights, r.adults, r.children, r.babies, r.meal, r.country, r.market_segment, r.distribution_channel, r.is_repeated_guest, r.previous_cancellations, r.previous_bookings_not_canceled, r.reserved_room_type, r.assigned_room_type, r.booking_changes, r.deposit_type, r.agent, r.company, r.days_in_waiting_list, r.customer_type, r.adr, r.required_car_parking_spaces, r.total_of_special_requests, r.reservation_status, LTRIM(RTRIM(REPLACE(r.reservation_status_date, CHAR(13), ''))))) AS row_hash, r.hotel AS raw_hotel, r.arrival_date_year AS raw_arrival_year, r.arrival_date_month AS raw_arrival_month, r.arrival_date_day_of_month AS raw_arrival_day, r.adr AS raw_adr, r.adults AS raw_adults, r.children AS raw_children, r.babies AS raw_babies, CASE WHEN TRY_CAST(r.adr AS DECIMAL(12,2)) &lt; 0 THEN 'ERR_NEGATIVE_ADR' WHEN TRY_CONVERT(DATE, CONCAT(r.arrival_date_year, '-', CASE LTRIM(RTRIM(r.arrival_date_month)) WHEN 'January' THEN '01' WHEN 'February' THEN '02' WHEN 'March' THEN '03' WHEN 'April' THEN '04' WHEN 'May' THEN '05' WHEN 'June' THEN '06' WHEN 'July' THEN '07' WHEN 'August' THEN '08' WHEN 'September' THEN '09' WHEN 'October' THEN '10' WHEN 'November' THEN '11' WHEN 'December' THEN '12' END, '-', RIGHT('0' + LTRIM(RTRIM(r.arrival_date_day_of_month)), 2)), 23) IS NULL OR TRY_CONVERT(DATE, LTRIM(RTRIM(REPLACE(r.reservation_status_date, CHAR(13), ''))), 23) IS NULL THEN 'ERR_INVALID_DATE' WHEN TRY_CAST(r.adr AS DECIMAL(12,2)) IS NULL OR TRY_CAST(r.lead_time AS INT) IS NULL OR TRY_CAST(r.lead_time AS INT) &lt; 0 OR TRY_CAST(r.stays_in_weekend_nights AS INT) IS NULL OR TRY_CAST(r.stays_in_weekend_nights AS INT) &lt; 0 OR TRY_CAST(r.stays_in_week_nights AS INT) IS NULL OR TRY_CAST(r.stays_in_week_nights AS INT) &lt; 0 OR TRY_CAST(r.adults AS INT) IS NULL OR TRY_CAST(r.adults AS INT) &lt; 0 OR TRY_CAST(r.babies AS INT) IS NULL OR TRY_CAST(r.babies AS INT) &lt; 0 OR TRY_CAST(r.is_canceled AS INT) NOT IN (0,1) OR TRY_CAST(r.is_repeated_guest AS INT) NOT IN (0,1) OR (COALESCE(NULLIF(LTRIM(RTRIM(r.children)),''),'NULL') NOT IN ('NA','NULL') AND (TRY_CAST(r.children AS DECIMAL(12,2)) IS NULL OR TRY_CAST(r.children AS DECIMAL(12,2)) &lt; 0)) THEN 'ERR_INVALID_NUMBER' WHEN NULLIF(LTRIM(RTRIM(r.hotel)),'') IS NULL OR NULLIF(LTRIM(RTRIM(r.reserved_room_type)),'') IS NULL OR NULLIF(LTRIM(RTRIM(r.assigned_room_type)),'') IS NULL OR NULLIF(LTRIM(RTRIM(r.customer_type)),'') IS NULL OR NULLIF(LTRIM(RTRIM(r.deposit_type)),'') IS NULL OR NULLIF(LTRIM(RTRIM(r.reservation_status)),'') IS NULL THEN 'ERR_MISSING_VALUE' WHEN LEN(LTRIM(RTRIM(r.country))) &gt; 10 OR LEN(LTRIM(RTRIM(r.agent))) &gt; 20 OR LEN(LTRIM(RTRIM(r.company))) &gt; 20 OR LEN(LTRIM(RTRIM(r.reserved_room_type))) &gt; 10 OR LEN(LTRIM(RTRIM(r.assigned_room_type))) &gt; 10 THEN 'ERR_INVALID_LENGTH' ELSE NULL END AS error_code, CAST(LTRIM(RTRIM(r.hotel)) AS VARCHAR(100)) AS hotel, CAST(ISNULL(TRY_CAST(r.is_canceled AS INT), 0) AS BIT) AS is_canceled, ISNULL(TRY_CAST(r.lead_time AS INT), 0) AS lead_time, TRY_CONVERT(DATE, CONCAT(r.arrival_date_year, '-', CASE LTRIM(RTRIM(r.arrival_date_month)) WHEN 'January' THEN '01' WHEN 'February' THEN '02' WHEN 'March' THEN '03' WHEN 'April' THEN '04' WHEN 'May' THEN '05' WHEN 'June' THEN '06' WHEN 'July' THEN '07' WHEN 'August' THEN '08' WHEN 'September' THEN '09' WHEN 'October' THEN '10' WHEN 'November' THEN '11' WHEN 'December' THEN '12' END, '-', RIGHT('0' + LTRIM(RTRIM(r.arrival_date_day_of_month)), 2)), 23) AS arrival_date, DATEADD(DAY, -ISNULL(TRY_CAST(r.lead_time AS INT), 0), TRY_CONVERT(DATE, CONCAT(r.arrival_date_year, '-', CASE LTRIM(RTRIM(r.arrival_date_month)) WHEN 'January' THEN '01' WHEN 'February' THEN '02' WHEN 'March' THEN '03' WHEN 'April' THEN '04' WHEN 'May' THEN '05' WHEN 'June' THEN '06' WHEN 'July' THEN '07' WHEN 'August' THEN '08' WHEN 'September' THEN '09' WHEN 'October' THEN '10' WHEN 'November' THEN '11' WHEN 'December' THEN '12' END, '-', RIGHT('0' + LTRIM(RTRIM(r.arrival_date_day_of_month)), 2)), 23)) AS booking_date, TRY_CONVERT(DATE, LTRIM(RTRIM(REPLACE(r.reservation_status_date, CHAR(13), ''))), 23) AS reservation_status_date, ISNULL(TRY_CAST(r.stays_in_weekend_nights AS INT), 0) AS stays_in_weekend_nights, ISNULL(TRY_CAST(r.stays_in_week_nights AS INT), 0) AS stays_in_week_nights, ISNULL(TRY_CAST(r.adults AS INT), 0) AS adults, CASE WHEN LTRIM(RTRIM(r.children)) IN ('NA','NULL','') OR r.children IS NULL THEN 0 ELSE ISNULL(TRY_CAST(TRY_CAST(r.children AS FLOAT) AS INT), 0) END AS children, ISNULL(TRY_CAST(r.babies AS INT), 0) AS babies, CAST(CASE WHEN LTRIM(RTRIM(r.meal)) IN ('Undefined','NA','NULL','') OR r.meal IS NULL THEN 'SC' ELSE LTRIM(RTRIM(r.meal)) END AS VARCHAR(50)) AS meal, CAST(CASE WHEN LTRIM(RTRIM(r.country)) IN ('NA','NULL','') OR r.country IS NULL THEN 'UNK' ELSE LTRIM(RTRIM(r.country)) END AS VARCHAR(10)) AS country, CAST(CASE WHEN LTRIM(RTRIM(r.market_segment)) IN ('Undefined','NA','NULL','') OR r.market_segment IS NULL THEN 'Unknown' ELSE LTRIM(RTRIM(r.market_segment)) END AS VARCHAR(100)) AS market_segment, CAST(CASE WHEN LTRIM(RTRIM(r.distribution_channel)) IN ('Undefined','NA','NULL','') OR r.distribution_channel IS NULL THEN 'Unknown' ELSE LTRIM(RTRIM(r.distribution_channel)) END AS VARCHAR(100)) AS distribution_channel, CAST(ISNULL(TRY_CAST(r.is_repeated_guest AS INT), 0) AS BIT) AS is_repeated_guest, ISNULL(TRY_CAST(r.previous_cancellations AS INT), 0) AS previous_cancellations, ISNULL(TRY_CAST(r.previous_bookings_not_canceled AS INT), 0) AS previous_bookings_not_canceled, CAST(LTRIM(RTRIM(r.reserved_room_type)) AS VARCHAR(10)) AS reserved_room_type, CAST(LTRIM(RTRIM(r.assigned_room_type)) AS VARCHAR(10)) AS assigned_room_type, ISNULL(TRY_CAST(r.booking_changes AS INT), 0) AS booking_changes, CAST(LTRIM(RTRIM(r.deposit_type)) AS VARCHAR(100)) AS deposit_type, CAST(CASE WHEN LTRIM(RTRIM(r.agent)) IN ('NA','NULL','') OR r.agent IS NULL THEN '0' ELSE LTRIM(RTRIM(r.agent)) END AS VARCHAR(20)) AS agent_id, CAST(CASE WHEN LTRIM(RTRIM(r.company)) IN ('NA','NULL','') OR r.company IS NULL THEN '0' ELSE LTRIM(RTRIM(r.company)) END AS VARCHAR(20)) AS company_id, ISNULL(TRY_CAST(r.days_in_waiting_list AS INT), 0) AS days_in_waiting_list, CAST(LTRIM(RTRIM(r.customer_type)) AS VARCHAR(100)) AS customer_type, ISNULL(TRY_CAST(r.adr AS DECIMAL(12,2)), 0) AS adr, ISNULL(TRY_CAST(r.required_car_parking_spaces AS INT), 0) AS required_car_parking_spaces, ISNULL(TRY_CAST(r.total_of_special_requests AS INT), 0) AS total_of_special_requests, CAST(LTRIM(RTRIM(r.reservation_status)) AS VARCHAR(50)) AS reservation_status FROM stg.hotel_bookings_raw r WHERE r.batch_id = &quot; + (DT_WSTR,12)@[User::BatchId] + &quot;) SELECT b.*, CAST(CASE WHEN b.error_code IS NULL AND ROW_NUMBER() OVER (PARTITION BY CASE WHEN b.error_code IS NULL THEN b.row_hash END ORDER BY b.staging_row_id) &gt; 1 THEN 1 ELSE 0 END AS BIT) AS is_exact_duplicate FROM Base b&quot;" DTS:Namespace="User" DTS:ObjectName="CleanSourceSql">
      <DTS:VariableValue DTS:DataType="8">SELECT 1 WHERE 1=0</DTS:VariableValue>
    </DTS:Variable>
  </DTS:Variables>
  <DTS:ConnectionManagers>
    <DTS:ConnectionManager DTS:refId="Package.ConnectionManagers[SQL Server Connection]" DTS:CreationName="OLEDB" DTS:DTSID="{B26636E6-3CEE-4FE3-8E1B-53991A82E9D2}" DTS:ObjectName="SQL Server Connection">
      <DTS:PropertyExpression DTS:Name="ConnectionString">@[$Package::SqlConnectionString]</DTS:PropertyExpression>
      <DTS:ObjectData>
        <DTS:ConnectionManager DTS:ConnectionString="Data Source=.\SQLEXPRESS;Initial Catalog=HotelBooking_DW;Provider=MSOLEDBSQL;Integrated Security=SSPI;Trust Server Certificate=True;" />
      </DTS:ObjectData>
    </DTS:ConnectionManager>
  </DTS:ConnectionManagers>
  <DTS:Executables>
    <DTS:Executable DTS:refId="Package\Get Source Batch" DTS:CreationName="Microsoft.ExecuteSQLTask" DTS:ExecutableType="Microsoft.ExecuteSQLTask" DTS:DTSID="{E60C5AF2-7B69-4174-BCBE-4616BDE70A6B}" DTS:ObjectName="Get Source Batch" DTS:DelayValidation="True">
      <DTS:ObjectData>
        <SQLTask:SqlTaskData SQLTask:Connection="{B26636E6-3CEE-4FE3-8E1B-53991A82E9D2}" SQLTask:SqlStatementSource="SET NOCOUNT ON;&#10;DECLARE @BatchId int = ?;&#10;IF @BatchId=0 SELECT @BatchId=MAX(l.batch_id) FROM meta.etl_batch_log l WHERE l.package_name='01_Ingest_CSV_To_RawStaging' AND l.status='SUCCESS' AND EXISTS (SELECT 1 FROM stg.hotel_bookings_raw r WHERE r.batch_id=l.batch_id);&#10;IF @BatchId IS NULL OR NOT EXISTS (SELECT 1 FROM meta.etl_batch_log WHERE batch_id=@BatchId AND package_name='01_Ingest_CSV_To_RawStaging' AND status='SUCCESS') THROW 50020, 'No successful source batch. Run package 01 first.', 1;&#10;IF NOT EXISTS (SELECT 1 FROM stg.hotel_bookings_raw WHERE batch_id=@BatchId) THROW 50021, 'Source batch has no raw rows.', 1;&#10;SELECT @BatchId;" SQLTask:ResultType="ResultSetType_SingleRow" SQLTask:TimeOut="0">
          <SQLTask:ParameterBinding SQLTask:ParameterName="0" SQLTask:DtsVariableName="$Package::SourceBatchId" SQLTask:ParameterDirection="Input" SQLTask:DataType="3" SQLTask:ParameterSize="-1" />
          <SQLTask:ResultBinding SQLTask:ResultName="0" SQLTask:DtsVariableName="User::BatchId" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable DTS:refId="Package\Start Batch" DTS:CreationName="Microsoft.ExecuteSQLTask" DTS:ExecutableType="Microsoft.ExecuteSQLTask" DTS:DTSID="{205EDEB5-7CBC-47A6-A1A3-9F44AD27D0BE}" DTS:ObjectName="Start Batch" DTS:DelayValidation="True">
      <DTS:ObjectData>
        <SQLTask:SqlTaskData SQLTask:Connection="{B26636E6-3CEE-4FE3-8E1B-53991A82E9D2}" SQLTask:SqlStatementSource="SET NOCOUNT ON;&#10;DECLARE @SourceBatchId int = ?;&#10;INSERT INTO meta.etl_batch_log(package_name,load_type,source_file,status) SELECT '02_Validate_And_Clean_Staging',load_type,source_file,'RUNNING' FROM meta.etl_batch_log WHERE batch_id=@SourceBatchId;&#10;SELECT CAST(SCOPE_IDENTITY() AS int);" SQLTask:ResultType="ResultSetType_SingleRow" SQLTask:TimeOut="0">
          <SQLTask:ParameterBinding SQLTask:ParameterName="0" SQLTask:DtsVariableName="User::BatchId" SQLTask:ParameterDirection="Input" SQLTask:DataType="3" SQLTask:ParameterSize="-1" />
          <SQLTask:ResultBinding SQLTask:ResultName="0" SQLTask:DtsVariableName="User::RunBatchId" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable DTS:refId="Package\Prepare Clean Batch" DTS:CreationName="Microsoft.ExecuteSQLTask" DTS:ExecutableType="Microsoft.ExecuteSQLTask" DTS:DTSID="{875071B0-9095-5802-9D76-DACC4EA61BA8}" DTS:ObjectName="Prepare Clean Batch" DTS:DelayValidation="True">
      <DTS:ObjectData>
        <SQLTask:SqlTaskData SQLTask:Connection="{B26636E6-3CEE-4FE3-8E1B-53991A82E9D2}" SQLTask:SqlStatementSource="DECLARE @BatchId int = ?;&#10;DELETE FROM stg.hotel_bookings_clean WHERE batch_id=@BatchId;&#10;DELETE FROM stg.hotel_bookings_error WHERE batch_id=@BatchId;&#10;DELETE FROM meta.data_quality_log WHERE batch_id=@BatchId;" SQLTask:ResultType="ResultSetType_None" SQLTask:TimeOut="0">
          <SQLTask:ParameterBinding SQLTask:ParameterName="0" SQLTask:DtsVariableName="User::BatchId" SQLTask:ParameterDirection="Input" SQLTask:DataType="3" SQLTask:ParameterSize="-1" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable DTS:refId="Package\DFT - Validate and Clean Staging" DTS:CreationName="Microsoft.Pipeline" DTS:ExecutableType="Microsoft.Pipeline" DTS:DTSID="{012747A7-8F56-5CB9-8A23-B57C387CBC4E}" DTS:ObjectName="DFT - Validate and Clean Staging" DTS:DelayValidation="True">
      <DTS:ObjectData>
        <pipeline version="1">
          <components>
            
            <component refId="Package\DFT - Validate and Clean Staging\Read Raw Staging" componentClassID="Microsoft.OLEDBSource" name="Read Raw Staging" usesDispositions="true" validateExternalMetadata="false" version="7">
