              </connections>
              <outputs>
                <output refId="Package\DFT - Validate and Clean Staging\Read Raw Staging.Outputs[OLE DB Source Output]" name="OLE DB Source Output">
                  <outputColumns>
                    <outputColumn refId="Package\DFT - Validate and Clean Staging\Read Raw Staging.Outputs[OLE DB Source Output].Columns[staging_row_id]" dataType="i8" errorOrTruncationOperation="Conversion" errorRowDisposition="FailComponent" externalMetadataColumnId="Package\DFT - Validate and Clean Staging\Read Raw Staging.Outputs[OLE DB Source Output].ExternalColumns[staging_row_id]" lineageId="Package\DFT - Validate and Clean Staging\Read Raw Staging.Outputs[OLE DB Source Output].Columns[staging_row_id]" name="staging_row_id" truncationRowDisposition="FailComponent" /><outputColumn refId="Package\DFT - Validate and Clean Staging\Read Raw Staging.Outputs[OLE DB Source Output].Columns[batch_id]" dataType="i4" errorOrTruncationOperation="Conversion" errorRowDisposition="FailComponent" externalMetadataColumnId="Package\DFT - Validate and Clean Staging\Read Raw Staging.Outputs[OLE DB Source Output].ExternalColumns[batch_id]" lineageId="Package\DFT - Validate and Clean Staging\Read Raw Staging.Outputs[OLE DB Source Output].Columns[batch_id]" name="batch_id" truncationRowDisposition="FailComponent" /><outputColumn refId="Package\DFT - Validate and Clean Staging\Read Raw Staging.Outputs[OLE DB Source Output].Columns[row_hash]" dataType="bytes" length="32" errorOrTruncationOperation="Conversion" errorRowDisposition="FailComponent" externalMetadataColumnId="Package\DFT - Validate and Clean Staging\Read Raw Staging.Outputs[OLE DB Source Output].ExternalColumns[row_hash]" lineageId="Package\DFT - Validate and Clean Staging\Read Raw Staging.Outputs[OLE DB Source Output].Columns[row_hash]" name="row_hash" truncationRowDisposition="FailComponent" /><outputColumn refId="Package\DFT - Validate and Clean Staging\Read Raw Staging.Outputs[OLE DB Source Output].Columns[raw_hotel]" dataType="str" length="100" codePage="1252" errorOrTruncationOperation="Conversion" errorRowDisposition="FailComponent" externalMetadataColumnId="Package\DFT - Validate and Clean Staging\Read Raw Staging.Outputs[OLE DB Source Output].ExternalColumns[raw_hotel]" lineageId="Package\DFT - Validate and Clean Staging\Read Raw Staging.Outputs[OLE DB Source Output].Columns[raw_hotel]" name="raw_hotel" truncationRowDisposition="FailComponent" /><outputColumn refId="Package\DFT - Validate and Clean Staging\Read Raw Staging.Outputs[OLE DB Source Output].Columns[raw_arrival_year]" dataType="str" length="50" codePage="1252" errorOrTruncationOperation="Conversion" errorRowDisposition="FailComponent" externalMetadataColumnId="Package\DFT - Validate and Clean Staging\Read Raw Staging.Outputs[OLE DB Source Output].ExternalColumns[raw_arrival_year]" lineageId="Package\DFT - Validate and Clean Staging\Read Raw Staging.Outputs[OLE DB Source Output].Columns[raw_arrival_year]" name="raw_arrival_year" truncationRowDisposition="FailComponent" /><outputColumn refId="Package\DFT - Validate and Clean Staging\Read Raw Staging.Outputs[OLE DB Source Output].Columns[raw_arrival_month]" dataType="str" length="50" codePage="1252" errorOrTruncationOperation="Conversion" errorRowDisposition="FailComponent" externalMetadataColumnId="Package\DFT - Validate and Clean Staging\Read Raw Staging.Outputs[OLE DB Source Output].ExternalColumns[raw_arrival_month]" lineageId="Package\DFT - Validate and Clean Staging\Read Raw Staging.Outputs[OLE DB Source Output].Columns[raw_arrival_month]" name="raw_arrival_month" truncationRowDisposition="FailComponent" /><outputColumn refId="Package\DFT - Validate and Clean Staging\Read Raw Staging.Outputs[OLE DB Source Output].Columns[raw_arrival_day]" dataType="str" length="50" codePage="1252" errorOrTruncationOperation="Conversion" errorRowDisposition="FailComponent" externalMetadataColumnId="Package\DFT - Validate and Clean Staging\Read Raw Staging.Outputs[OLE DB Source Output].ExternalColumns[raw_arrival_day]" lineageId="Package\DFT - Validate and Clean Staging\Read Raw Staging.Outputs[OLE DB Source Output].Columns[raw_arrival_day]" name="raw_arrival_day" truncationRowDi