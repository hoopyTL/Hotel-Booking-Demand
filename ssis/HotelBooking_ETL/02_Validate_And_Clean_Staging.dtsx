  <DTS:Executables>
    <DTS:Executable DTS:refId="Package\Get Source Batch" DTS:CreationName="Microsoft.ExecuteSQLTask" DTS:ExecutableType="Microsoft.ExecuteSQLTask" DTS:DTSID="{E60C5AF2-7B69-4174-BCBE-4616BDE70A6B}" DTS:ObjectName="Get Source Batch" DTS:DelayValidation="True">
      <DTS:ObjectData>
        <SQLTask:SqlTaskData SQLTask:Connection="{B26636E6-3CEE-4FE3-8E1B-53991A82E9D2}" SQLTask:SqlStatementSource="SET NOCOUNT ON;&#10;DECLARE @BatchId int = ?;&#10;IF @BatchId=0 SELECT @BatchId=MAX(l.batch_id) FROM meta.etl_batch_log l&#10;WHERE l.package_name='01_Ingest_CSV_To_RawStaging' AND l.status='SUCCESS'&#10;AND EXISTS (SELECT 1 FROM stg.hotel_bookings_raw r WHERE r.batch_id=l.batch_id);&#10;IF @BatchId IS NULL OR NOT EXISTS (SELECT 1 FROM meta.etl_batch_log WHERE batch_id=@BatchId AND package_name='01_Ingest_CSV_To_RawStaging' AND status='SUCCESS')&#10;    THROW 50020, 'No successful source batch. Run package 01 first.', 1;&#10;IF NOT EXISTS (SELECT 1 FROM stg.hotel_bookings_raw WHERE batch_id=@BatchId)&#10;    THROW 50021, 'Source batch has no raw rows.', 1;&#10;SELECT @BatchId;" SQLTask:ResultType="ResultSetType_SingleRow" SQLTask:TimeOut="0">
          <SQLTask:ParameterBinding SQLTask:ParameterName="0" SQLTask:DtsVariableName="$Package::SourceBatchId" SQLTask:ParameterDirection="Input" SQLTask:DataType="3" SQLTask:ParameterSize="-1" />
          <SQLTask:ResultBinding SQLTask:ResultName="0" SQLTask:DtsVariableName="User::BatchId" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable DTS:refId="Package\Start Batch" DTS:CreationName="Microsoft.ExecuteSQLTask" DTS:ExecutableType="Microsoft.ExecuteSQLTask" DTS:DTSID="{205EDEB5-7CBC-47A6-A1A3-9F44AD27D0BE}" DTS:ObjectName="Start Batch" DTS:DelayValidation="True">
      <DTS:ObjectData>
        <SQLTask:SqlTaskData SQLTask:Connection="{B26636E6-3CEE-4FE3-8E1B-53991A82E9D2}" SQLTask:SqlStatementSource="SET NOCOUNT ON;&#10;DECLARE @SourceBatchId int = ?;&#10;INSERT INTO meta.etl_batch_log(package_name,load_type,source_file,status)&#10;SELECT '02_Validate_And_Clean_Staging',load_type,source_file,'RUNNING' FROM meta.etl_batch_log WHERE batch_id=@SourceBatchId;&#10;SELECT CAST(SCOPE_IDENTITY() AS int);" SQLTask:ResultType="ResultSetType_SingleRow" SQLTask:TimeOut="0">
          <SQLTask:ParameterBinding SQLTask:ParameterName="0" SQLTask:DtsVariableName="User::BatchId" SQLTask:ParameterDirection="Input" SQLTask:DataType="3" SQLTask:ParameterSize="-1" />
          <SQLTask:ResultBinding SQLTask:ResultName="0" SQLTask:DtsVariableName="User::RunBatchId" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable DTS:refId="Package\Clean Staging" DTS:CreationName="Microsoft.ExecuteSQLTask" DTS:ExecutableType="Microsoft.ExecuteSQLTask" DTS:DTSID="{5171BC18-F70B-418D-948A-53F18650720F}" DTS:ObjectName="Clean Staging" DTS:DelayValidation="True">
      <DTS:ObjectData>
        <SQLTask:SqlTaskData SQLTask:Connection="{B26636E6-3CEE-4FE3-8E1B-53991A82E9D2}" SQLTask:SqlStatementSource="EXEC stg.sp_clean_and_validate_staging @BatchId = ?;" SQLTask:ResultType="ResultSetType_None" SQLTask:TimeOut="0">
          <SQLTask:ParameterBinding SQLTask:ParameterName="0" SQLTask:DtsVariableName="User::BatchId" SQLTask:ParameterDirection="Input" SQLTask:DataType="3" SQLTask:ParameterSize="-1" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable DTS:refId="Package\Check Row Counts" DTS:CreationName="Microsoft.ExecuteSQLTask" DTS:ExecutableType="Microsoft.ExecuteSQLTask" DTS:DTSID="{141A50FE-F99C-473E-AC70-1D266CF535FA}" DTS:ObjectName="Check Row Counts" DTS:DelayValidation="True">
      <DTS:ObjectData>
        <SQLTask:SqlTaskData SQLTask:Connection="{B26636E6-3CEE-4FE3-8E1B-53991A82E9D2}" SQLTask:SqlStatementSource="DECLARE @BatchId int = ?;&#10;DECLARE @Raw int=(SELECT COUNT(*) FROM stg.hotel_bookings_raw WHERE batch_id=@BatchId),&#10;@Clean int=(SELECT COUNT(*) FROM stg.hotel_bookings_clean WHERE batch_id=@BatchId),&#10;@Rejected int=(SELECT COUNT(*) FROM stg.hotel_bookings_error WHERE batch_id=@BatchId);&#10;IF @Raw &lt;&gt; @Clean + @Rejected THROW 50022, 'Row counts do not match: raw must equal clean plus rejected.', 1;&#10;IF EXISTS (SELECT 1 FROM stg.hotel_bookings_clean c JOIN stg.hotel_bookings_error e ON e.staging_row_id=c.staging_row_id WHERE c.batch_id=@BatchId)&#10;    THROW 50023, 'A row exists in both clean and error tables.', 1;" SQLTask:ResultType="ResultSetType_None" SQLTask:TimeOut="0">
          <SQLTask:ParameterBinding SQLTask:ParameterName="0" SQLTask:DtsVariableName="User::BatchId" SQLTask:ParameterDirection="Input" SQLTask:DataType="3" SQLTask:ParameterSize="-1" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable DTS:refId="Package\End Batch" DTS:CreationName="Microsoft.ExecuteSQLTask" DTS:ExecutableType="Microsoft.ExecuteSQLTask" DTS:DTSID="{DB69A06A-CC7A-40FF-B88D-99C81DB0E321}" DTS:ObjectName="End Batch" DTS:DelayValidation="True">
      <DTS:ObjectData>
        <SQLTask:SqlTaskData SQLTask:Connection="{B26636E6-3CEE-4FE3-8E1B-53991A82E9D2}" SQLTask:SqlStatementSource="DECLARE @SourceBatchId int = ?, @RunBatchId int = ?;&#10;UPDATE meta.etl_batch_log SET status='SUCCESS',end_time=SYSDATETIME(),&#10;rows_extracted=(SELECT COUNT(*) FROM stg.hotel_bookings_raw WHERE batch_id=@SourceBatchId),&#10;rows_inserted=(SELECT COUNT(*) FROM stg.hotel_bookings_clean WHERE batch_id=@SourceBatchId),&#10;rows_rejected=(SELECT COUNT(*) FROM stg.hotel_bookings_error WHERE batch_id=@SourceBatchId)&#10;WHERE batch_id=@RunBatchId;" SQLTask:ResultType="ResultSetType_None" SQLTask:TimeOut="0">
          <SQLTask:ParameterBinding SQLTask:ParameterName="0" SQLTask:DtsVariableName="User::BatchId" SQLTask:ParameterDirection="Input" SQLTask:DataType="3" SQLTask:ParameterSize="-1" />
          <SQLTask:ParameterBinding SQLTask:ParameterName="1" SQLTask:DtsVariableName="User::RunBatchId" SQLTask:ParameterDirection="Input" SQLTask:DataType="3" SQLTask:ParameterSize="-1" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
