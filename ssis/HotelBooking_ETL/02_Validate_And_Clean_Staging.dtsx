    <DTS:Executable DTS:refId="Package\Log Data Quality Rules" DTS:CreationName="Microsoft.ExecuteSQLTask" DTS:ExecutableType="Microsoft.ExecuteSQLTask" DTS:DTSID="{0CC889E7-399C-551E-A553-02F7AC57F5BE}" DTS:ObjectName="Log Data Quality Rules" DTS:DelayValidation="True">
      <DTS:ObjectData>
        <SQLTask:SqlTaskData SQLTask:Connection="{B26636E6-3CEE-4FE3-8E1B-53991A82E9D2}" SQLTask:SqlStatementSource="DECLARE @BatchId int = ?;&#10;INSERT INTO meta.data_quality_log (batch_id, rule_name, severity, affected_rows, rule_description)&#10;SELECT @BatchId, 'ERR_NEGATIVE_ADR', 'ERROR', COUNT(*), N'Bản ghi có ADR &lt; 0 bị chuyển sang Quarantine' FROM stg.hotel_bookings_error WHERE batch_id=@BatchId AND error_code='ERR_NEGATIVE_ADR'&#10;UNION ALL&#10;SELECT @BatchId, error_code, 'ERROR', COUNT(*), MAX(error_reason) FROM stg.hotel_bookings_error WHERE batch_id=@BatchId AND error_code &lt;&gt; 'ERR_NEGATIVE_ADR' GROUP BY error_code&#10;UNION ALL&#10;SELECT @BatchId, 'WARN_ADR_OUTLIER', 'WARNING', COUNT(*), N'Bản ghi có ADR &gt; 1000 được gắn cờ is_adr_outlier' FROM stg.hotel_bookings_clean WHERE batch_id=@BatchId AND is_adr_outlier=1&#10;UNION ALL&#10;SELECT @BatchId, 'WARN_ZERO_GUESTS', 'WARNING', COUNT(*), N'Bản ghi có tổng khách = 0 được gắn cờ is_zero_guest' FROM stg.hotel_bookings_clean WHERE batch_id=@BatchId AND is_zero_guest=1&#10;UNION ALL&#10;SELECT @BatchId, 'INFO_EXACT_DUPLICATE', 'WARNING', COUNT(*), N'Bản ghi trùng lặp hoàn toàn trên 32 cột được gắn cờ is_exact_duplicate' FROM stg.hotel_bookings_clean WHERE batch_id=@BatchId AND is_exact_duplicate=1;" SQLTask:ResultType="ResultSetType_None" SQLTask:TimeOut="0">
          <SQLTask:ParameterBinding SQLTask:ParameterName="0" SQLTask:DtsVariableName="User::BatchId" SQLTask:ParameterDirection="Input" SQLTask:DataType="3" SQLTask:ParameterSize="-1" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable DTS:refId="Package\Check Row Counts" DTS:CreationName="Microsoft.ExecuteSQLTask" DTS:ExecutableType="Microsoft.ExecuteSQLTask" DTS:DTSID="{141A50FE-F99C-473E-AC70-1D266CF535FA}" DTS:ObjectName="Check Row Counts" DTS:DelayValidation="True">
      <DTS:ObjectData>
        <SQLTask:SqlTaskData SQLTask:Connection="{B26636E6-3CEE-4FE3-8E1B-53991A82E9D2}" SQLTask:SqlStatementSource="DECLARE @BatchId int = ?;&#10;DECLARE @Raw int=(SELECT COUNT(*) FROM stg.hotel_bookings_raw WHERE batch_id=@BatchId),&#10;@Clean int=(SELECT COUNT(*) FROM stg.hotel_bookings_clean WHERE batch_id=@BatchId),&#10;@Rejected int=(SELECT COUNT(*) FROM stg.hotel_bookings_error WHERE batch_id=@BatchId);&#10;IF @Raw &lt;&gt; @Clean + @Rejected THROW 50022, 'Row counts do not match: raw must equal clean plus rejected.', 1;&#10;IF EXISTS (SELECT 1 FROM stg.hotel_bookings_clean c JOIN stg.hotel_bookings_error e ON e.staging_row_id=c.staging_row_id WHERE c.batch_id=@BatchId) THROW 50023, 'A row exists in both clean and error tables.', 1;" SQLTask:ResultType="ResultSetType_None" SQLTask:TimeOut="0">
          <SQLTask:ParameterBinding SQLTask:ParameterName="0" SQLTask:DtsVariableName="User::BatchId" SQLTask:ParameterDirection="Input" SQLTask:DataType="3" SQLTask:ParameterSize="-1" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable DTS:refId="Package\End Batch" DTS:CreationName="Microsoft.ExecuteSQLTask" DTS:ExecutableType="Microsoft.ExecuteSQLTask" DTS:DTSID="{DB69A06A-CC7A-40FF-B88D-99C81DB0E321}" DTS:ObjectName="End Batch" DTS:DelayValidation="True">
      <DTS:ObjectData>
        <SQLTask:SqlTaskData SQLTask:Connection="{B26636E6-3CEE-4FE3-8E1B-53991A82E9D2}" SQLTask:SqlStatementSource="DECLARE @SourceBatchId int = ?, @RunBatchId int = ?, @RowsClean int = ?, @RowsRejected int = ?;&#10;UPDATE meta.etl_batch_log SET status='SUCCESS', end_time=SYSDATETIME(), rows_extracted=(SELECT COUNT(*) FROM stg.hotel_bookings_raw WHERE batch_id=@SourceBatchId), rows_inserted=@RowsClean, rows_rejected=@RowsRejected WHERE batch_id=@RunBatchId;" SQLTask:ResultType="ResultSetType_None" SQLTask:TimeOut="0">
          <SQLTask:ParameterBinding SQLTask:ParameterName="0" SQLTask:DtsVariableName="User::BatchId" SQLTask:ParameterDirection="Input" SQLTask:DataType="3" SQLTask:ParameterSize="-1" />
          <SQLTask:ParameterBinding SQLTask:ParameterName="1" SQLTask:DtsVariableName="User::RunBatchId" SQLTask:ParameterDirection="Input" SQLTask:DataType="3" SQLTask:ParameterSize="-1" />
          <SQLTask:ParameterBinding SQLTask:ParameterName="2" SQLTask:DtsVariableName="User::RowsClean" SQLTask:ParameterDirection="Input" SQLTask:DataType="3" SQLTask:ParameterSize="-1" />
          <SQLTask:ParameterBinding SQLTask:ParameterName="3" SQLTask:DtsVariableName="User::RowsRejected" SQLTask:ParameterDirection="Input" SQLTask:DataType="3" SQLTask:ParameterSize="-1" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
