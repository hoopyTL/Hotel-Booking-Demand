    <DTS:PrecedenceConstraint DTS:refId="Package.PrecedenceConstraints[{4D3BAB44-4780-49C9-971C-76FDC7A0566E}]" DTS:CreationName="" DTS:DTSID="{0233BEB3-B138-4403-A624-08ED0CF55772}" DTS:ObjectName="Success" DTS:From="Package\Clean Staging" DTS:To="Package\Check Row Counts" DTS:Value="0" DTS:LogicalAnd="True" />
