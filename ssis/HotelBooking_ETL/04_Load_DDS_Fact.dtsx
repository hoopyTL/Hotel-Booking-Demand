    <DTS:Variable DTS:DTSID="{C7EC5632-B27F-51FA-ADA9-35C4121222E1}" DTS:Namespace="User" DTS:ObjectName="RowsFactBooking">
      <DTS:VariableValue DTS:DataType="3">0</DTS:VariableValue>
    </DTS:Variable>
    <DTS:Variable DTS:DTSID="{70950AE4-9D68-5713-B92D-50CC6A62EF0C}" DTS:Namespace="User" DTS:ObjectName="RowsDailyStay">
      <DTS:VariableValue DTS:DataType="3">0</DTS:VariableValue>
    </DTS:Variable>
    <DTS:Variable DTS:DTSID="{928D44C4-076B-4DCA-A518-835390203F79}" DTS:EvaluateAsExpression="True" DTS:Expression="@[User::RowsFactBooking] + @[User::RowsDailyStay]" DTS:Namespace="User" DTS:ObjectName="RowsInserted">
      <DTS:VariableValue DTS:DataType="3">0</DTS:VariableValue>
    </DTS:Variable>
    <DTS:Variable DTS:DTSID="{95337FE2-7E58-56DE-B680-AE267260922E}" DTS:EvaluateAsExpression="True" DTS:Expression="&quot;SELECT c.staging_row_id AS booking_source_id, c.batch_id, CONVERT(INT, CONVERT(CHAR(8), c.arrival_date, 112)) AS arrival_date_key, CONVERT(INT, CONVERT(CHAR(8), c.booking_date, 112)) AS booking_date_key, CONVERT(INT, CONVERT(CHAR(8), c.reservation_status_date, 112)) AS status_date_key, c.hotel, c.country, c.market_segment, c.distribution_channel, c.reserved_room_type, c.assigned_room_type, CAST(c.customer_type AS VARCHAR(50)) AS customer_type, CAST(c.deposit_type AS VARCHAR(50)) AS deposit_type, CAST(c.meal AS VARCHAR(20)) AS meal_code, c.is_repeated_guest, c.reservation_status, c.agent_id, c.company_id, c.lead_time, c.stays_in_weekend_nights, c.stays_in_week_nights, c.total_nights, c.adults, c.children, c.babies, c.total_guests, c.adr, c.estimated_revenue, c.actual_revenue, c.lost_revenue, c.booking_changes, c.days_in_waiting_list, c.required_car_parking_spaces, c.total_of_special_requests, c.previous_cancellations, c.previous_bookings_not_canceled, c.is_room_changed, c.is_adr_outlier, c.is_zero_guest, c.is_exact_duplicate FROM stg.hotel_bookings_clean c WHERE c.batch_id = &quot; + (DT_WSTR,12)@[User::BatchId]" DTS:Namespace="User" DTS:ObjectName="SqlFactBooking">
      <DTS:VariableValue DTS:DataType="8">SELECT 1 WHERE 1=0</DTS:VariableValue>
    </DTS:Variable>
    <DTS:Variable DTS:DTSID="{77E9B3BC-D903-597B-8DFF-29F8DEE8B328}" DTS:EvaluateAsExpression="True" DTS:Expression="&quot;SELECT b.booking_source_id, b.batch_id, d.date_key AS stay_date_key, b.hotel_key, b.assigned_room_type_key, b.market_segment_key, b.booking_profile_key, DATEDIFF(DAY, a.full_date, d.full_date) + 1 AS night_index, 1 AS night_count, d.is_weekend AS is_weekend_night, b.adr AS daily_revenue FROM dw.Fact_Hotel_Booking b JOIN dw.Dim_Reservation_Status s ON s.reservation_status_key = b.reservation_status_key JOIN dw.Dim_Date a ON a.date_key = b.arrival_date_key JOIN dw.Dim_Date d ON d.full_date &gt;= a.full_date AND d.full_date &lt; DATEADD(DAY, b.total_nights, a.full_date) WHERE b.batch_id = &quot; + (DT_WSTR,12)@[User::BatchId] + &quot; AND s.is_canceled = 0 AND b.total_nights &gt; 0&quot;" DTS:Namespace="User" DTS:ObjectName="SqlDailyStay">
      <DTS:VariableValue DTS:DataType="8">SELECT 1 WHERE 1=0</DTS:VariableValue>
    </DTS:Variable>
  </DTS:Variables>
