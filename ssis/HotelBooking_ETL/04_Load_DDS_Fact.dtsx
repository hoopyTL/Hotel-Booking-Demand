  <DTS:Executables>
    <DTS:Executable DTS:refId="Package\Get Source Batch" DTS:CreationName="Microsoft.ExecuteSQLTask" DTS:ExecutableType="Microsoft.ExecuteSQLTask" DTS:DTSID="{54FA6661-56B8-48F9-9E7C-0C9C393B4BF8}" DTS:ObjectName="Get Source Batch" DTS:DelayValidation="True">
      <DTS:ObjectData>
        <SQLTask:SqlTaskData SQLTask:Connection="{1D8E9115-018D-42D3-88CE-D18C406E4985}" SQLTask:SqlStatementSource="SET NOCOUNT ON;&#10;DECLARE @BatchId int = ?;&#10;IF @BatchId=0 SELECT @BatchId=MAX(l.batch_id) FROM meta.etl_batch_log l&#10;WHERE l.package_name='01_Ingest_CSV_To_RawStaging' AND l.status='SUCCESS'&#10;AND EXISTS (SELECT 1 FROM stg.hotel_bookings_clean c WHERE c.batch_id=l.batch_id);&#10;IF @BatchId IS NULL OR NOT EXISTS (SELECT 1 FROM meta.etl_batch_log WHERE batch_id=@BatchId AND package_name='01_Ingest_CSV_To_RawStaging' AND status='SUCCESS')&#10;    THROW 50040, 'No valid source batch. Run packages 01 and 02 first.',1;&#10;IF NOT EXISTS (SELECT 1 FROM stg.hotel_bookings_clean WHERE batch_id=@BatchId)&#10;    THROW 50041, 'Source batch has no clean rows. Run package 02 first.',1;&#10;IF (SELECT COUNT(*) FROM stg.hotel_bookings_raw WHERE batch_id=@BatchId) &lt;&gt;&#10;   (SELECT COUNT(*) FROM stg.hotel_bookings_clean WHERE batch_id=@BatchId) +&#10;   (SELECT COUNT(*) FROM stg.hotel_bookings_error WHERE batch_id=@BatchId)&#10;    THROW 50042, 'Clean staging row counts do not match source batch.',1;&#10;SELECT @BatchId;" SQLTask:ResultType="ResultSetType_SingleRow" SQLTask:TimeOut="0">
          <SQLTask:ParameterBinding SQLTask:ParameterName="0" SQLTask:DtsVariableName="$Package::SourceBatchId" SQLTask:ParameterDirection="Input" SQLTask:DataType="3" SQLTask:ParameterSize="-1" />
          <SQLTask:ResultBinding SQLTask:ResultName="0" SQLTask:DtsVariableName="User::BatchId" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable DTS:refId="Package\Start Batch" DTS:CreationName="Microsoft.ExecuteSQLTask" DTS:ExecutableType="Microsoft.ExecuteSQLTask" DTS:DTSID="{5CF50636-1BF8-40D6-B414-C60431DAC550}" DTS:ObjectName="Start Batch" DTS:DelayValidation="True">
      <DTS:ObjectData>
        <SQLTask:SqlTaskData SQLTask:Connection="{1D8E9115-018D-42D3-88CE-D18C406E4985}" SQLTask:SqlStatementSource="SET NOCOUNT ON;&#10;DECLARE @SourceBatchId int = ?;&#10;INSERT INTO meta.etl_batch_log(package_name,load_type,source_file,status)&#10;SELECT '04_Load_DDS_Fact',load_type,source_file,'RUNNING' FROM meta.etl_batch_log WHERE batch_id=@SourceBatchId;&#10;SELECT CAST(SCOPE_IDENTITY() AS int);" SQLTask:ResultType="ResultSetType_SingleRow" SQLTask:TimeOut="0">
          <SQLTask:ParameterBinding SQLTask:ParameterName="0" SQLTask:DtsVariableName="User::BatchId" SQLTask:ParameterDirection="Input" SQLTask:DataType="3" SQLTask:ParameterSize="-1" />
          <SQLTask:ResultBinding SQLTask:ResultName="0" SQLTask:DtsVariableName="User::RunBatchId" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable DTS:refId="Package\Check Dimension Keys" DTS:CreationName="Microsoft.ExecuteSQLTask" DTS:ExecutableType="Microsoft.ExecuteSQLTask" DTS:DTSID="{82DB15F0-775A-492E-8456-CB043EB4B7BD}" DTS:ObjectName="Check Dimension Keys" DTS:DelayValidation="True">
      <DTS:ObjectData>
        <SQLTask:SqlTaskData SQLTask:Connection="{1D8E9115-018D-42D3-88CE-D18C406E4985}" SQLTask:SqlStatementSource="DECLARE @BatchId int = ?;&#10;IF EXISTS (SELECT 1 FROM stg.hotel_bookings_clean c WHERE c.batch_id=@BatchId AND (&#10;NOT EXISTS (SELECT 1 FROM dw.Dim_Hotel d WHERE d.hotel_name=c.hotel) OR&#10;NOT EXISTS (SELECT 1 FROM dw.Dim_Country d WHERE d.country_iso3=c.country) OR&#10;NOT EXISTS (SELECT 1 FROM dw.Dim_Market_Segment d WHERE d.market_segment_name=c.market_segment) OR&#10;NOT EXISTS (SELECT 1 FROM dw.Dim_Distribution_Channel d WHERE d.distribution_channel_name=c.distribution_channel) OR&#10;NOT EXISTS (SELECT 1 FROM dw.Dim_Room_Type d WHERE d.room_type_code=c.reserved_room_type) OR&#10;NOT EXISTS (SELECT 1 FROM dw.Dim_Room_Type d WHERE d.room_type_code=c.assigned_room_type) OR&#10;NOT EXISTS (SELECT 1 FROM dw.Dim_Booking_Profile d WHERE d.customer_type=c.customer_type AND d.deposit_type=c.deposit_type AND d.meal_code=c.meal AND d.is_repeated_guest=c.is_repeated_guest) OR&#10;NOT EXISTS (SELECT 1 FROM dw.Dim_Reservation_Status d WHERE d.reservation_status=c.reservation_status AND d.is_canceled=c.is_canceled) OR&#10;NOT EXISTS (SELECT 1 FROM dw.Dim_Agent_Company d WHERE d.agent_id=c.agent_id AND d.company_id=c.company_id) OR&#10;NOT EXISTS (SELECT 1 FROM dw.Dim_Date d WHERE d.full_date=c.arrival_date) OR&#10;NOT EXISTS (SELECT 1 FROM dw.Dim_Date d WHERE d.full_date=c.booking_date) OR&#10;NOT EXISTS (SELECT 1 FROM dw.Dim_Date d WHERE d.full_date=c.reservation_status_date))) THROW 50043, 'Some clean rows have missing dimension keys.',1;&#10;IF EXISTS (SELECT 1 FROM stg.hotel_bookings_clean c WHERE c.batch_id=@BatchId AND c.is_canceled=0 AND c.total_nights&gt;0 AND NOT EXISTS (SELECT 1 FROM dw.Dim_Date d WHERE d.full_date=DATEADD(DAY,c.total_nights-1,c.arrival_date))) THROW 50050, 'Stay dates are missing. Run package 03 first.',1;" SQLTask:ResultType="ResultSetType_None" SQLTask:TimeOut="0">
          <SQLTask:ParameterBinding SQLTask:ParameterName="0" SQLTask:DtsVariableName="User::BatchId" SQLTask:ParameterDirection="Input" SQLTask:DataType="3" SQLTask:ParameterSize="-1" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable DTS:refId="Package\Load Booking Fact" DTS:CreationName="Microsoft.ExecuteSQLTask" DTS:ExecutableType="Microsoft.ExecuteSQLTask" DTS:DTSID="{B4E34C5D-2652-45E8-B13B-9BF08160A6CC}" DTS:ObjectName="Load Booking Fact" DTS:DelayValidation="True">
      <DTS:ObjectData>
        <SQLTask:SqlTaskData SQLTask:Connection="{1D8E9115-018D-42D3-88CE-D18C406E4985}" SQLTask:SqlStatementSource="SET NOCOUNT ON;&#10;DECLARE @BatchId int = ?, @RowsInserted int = ?;&#10;INSERT INTO [dw].[Fact_Hotel_Booking] (&#10;        [booking_source_id], [batch_id],&#10;        [arrival_date_key], [booking_date_key], [status_date_key],&#10;        [hotel_key], [country_key], [market_segment_key], [distribution_channel_key],&#10;        [reserved_room_type_key], [assigned_room_type_key],&#10;        [booking_profile_key], [reservation_status_key], [agent_company_key],&#10;        [lead_time], [stays_in_weekend_nights], [stays_in_week_nights], [total_nights],&#10;        [adults], [children], [babies], [total_guests],&#10;        [adr], [estimated_revenue], [actual_revenue], [lost_revenue],&#10;        [booking_changes], [days_in_waiting_list],&#10;        [required_car_parking_spaces], [total_of_special_requests],&#10;        [previous_cancellations], [previous_bookings_not_canceled],&#10;        [is_room_changed], [is_adr_outlier], [is_zero_guest], [is_exact_duplicate]&#10;    )&#10;    SELECT&#10;        c.[staging_row_id] AS [booking_source_id],&#10;        c.[batch_id],&#10;        CONVERT(INT, CONVERT(char(8),c.[arrival_date],112)) AS [arrival_date_key],&#10;        CONVERT(INT, CONVERT(char(8),c.[booking_date],112)) AS [booking_date_key],&#10;        CONVERT(INT, CONVERT(char(8),c.[reservation_status_date],112)) AS [status_date_key],&#10;        dh.[hotel_key],&#10;        dc.[country_key],&#10;        dms.[market_segment_key],&#10;        ddc.[distribution_channel_key],&#10;        dr_res.[room_type_key] AS [reserved_room_type_key],&#10;        dr_ass.[room_type_key] AS [assigned_room_type_key],&#10;        dbp.[booking_profile_key],&#10;        drs.[reservation_status_key],&#10;        dac.[agent_company_key],&#10;        c.[lead_time], c.[stays_in_weekend_nights], c.[stays_in_week_nights], c.[total_nights],&#10;        c.[adults], c.[children], c.[babies], c.[total_guests],&#10;        c.[adr], c.[estimated_revenue], c.[actual_revenue], c.[lost_revenue],&#10;        c.[booking_changes], c.[days_in_waiting_list],&#10;        c.[required_car_parking_spaces], c.[total_of_special_requests],&#10;        c.[previous_cancellations], c.[previous_bookings_not_canceled],&#10;        c.[is_room_changed], c.[is_adr_outlier], c.[is_zero_guest], c.[is_exact_duplicate]&#10;    FROM [stg].[hotel_bookings_clean] c&#10;    INNER JOIN [dw].[Dim_Hotel] dh ON dh.[hotel_name] = c.[hotel]&#10;    INNER JOIN [dw].[Dim_Country] dc ON dc.[country_iso3] = c.[country]&#10;    INNER JOIN [dw].[Dim_Market_Segment] dms ON dms.[market_segment_name] = c.[market_segment]&#10;    INNER JOIN [dw].[Dim_Distribution_Channel] ddc ON ddc.[distribution_channel_name] = c.[distribution_channel]&#10;    INNER JOIN [dw].[Dim_Room_Type] dr_res ON dr_res.[room_type_code] = c.[reserved_room_type]&#10;    INNER JOIN [dw].[Dim_Room_Type] dr_ass ON dr_ass.[room_type_code] = c.[assigned_room_type]&#10;    INNER JOIN [dw].[Dim_Booking_Profile] dbp&#10;        ON dbp.[customer_type]     = c.[customer_type]&#10;       AND dbp.[deposit_type]      = c.[deposit_type]&#10;       AND dbp.[meal_code]         = c.[meal]&#10;       AND dbp.[is_repeated_guest] = c.[is_repeated_guest]&#10;    INNER JOIN [dw].[Dim_Reservation_Status] drs ON drs.[reservation_status] = c.[reservation_status]&#10;    INNER JOIN [dw].[Dim_Agent_Company] dac&#10;        ON dac.[agent_id]   = c.[agent_id]&#10;       AND dac.[company_id] = c.[company_id]&#10;    WHERE c.[batch_id] = @BatchId&#10;      AND NOT EXISTS (&#10;          SELECT 1 FROM [dw].[Fact_Hotel_Booking] f&#10;          WHERE f.[booking_source_id] = c.[staging_row_id]&#10;      );&#10;SELECT @RowsInserted+@@ROWCOUNT;" SQLTask:ResultType="ResultSetType_SingleRow" SQLTask:TimeOut="0">
          <SQLTask:ParameterBinding SQLTask:ParameterName="0" SQLTask:DtsVariableName="User::BatchId" SQLTask:ParameterDirection="Input" SQLTask:DataType="3" SQLTask:ParameterSize="-1" />
          <SQLTask:ParameterBinding SQLTask:ParameterName="1" SQLTask:DtsVariableName="User::RowsInserted" SQLTask:ParameterDirection="Input" SQLTask:DataType="3" SQLTask:ParameterSize="-1" />
          <SQLTask:ResultBinding SQLTask:ResultName="0" SQLTask:DtsVariableName="User::RowsInserted" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable DTS:refId="Package\Load Daily Stay Fact" DTS:CreationName="Microsoft.ExecuteSQLTask" DTS:ExecutableType="Microsoft.ExecuteSQLTask" DTS:DTSID="{6AE0FAB9-F4BA-451F-B298-6397EE4CE7D6}" DTS:ObjectName="Load Daily Stay Fact" DTS:DelayValidation="True">
      <DTS:ObjectData>
        <SQLTask:SqlTaskData SQLTask:Connection="{1D8E9115-018D-42D3-88CE-D18C406E4985}" SQLTask:SqlStatementSource="SET NOCOUNT ON;&#10;DECLARE @BatchId int = ?, @RowsInserted int = ?;&#10;INSERT INTO dw.Fact_Daily_Stay_Snapshot&#10;(booking_source_id,batch_id,stay_date_key,hotel_key,assigned_room_type_key,market_segment_key,booking_profile_key,night_index,night_count,is_weekend_night,daily_revenue)&#10;SELECT b.booking_source_id,b.batch_id,d.date_key,b.hotel_key,b.assigned_room_type_key,b.market_segment_key,b.booking_profile_key,&#10;DATEDIFF(DAY,a.full_date,d.full_date)+1,1,d.is_weekend,b.adr&#10;FROM dw.Fact_Hotel_Booking b&#10;JOIN dw.Dim_Reservation_Status s ON s.reservation_status_key=b.reservation_status_key&#10;JOIN dw.Dim_Date a ON a.date_key=b.arrival_date_key&#10;JOIN dw.Dim_Date d ON d.full_date&gt;=a.full_date AND d.full_date&lt;DATEADD(DAY,b.total_nights,a.full_date)&#10;WHERE b.batch_id=@BatchId AND s.is_canceled=0 AND b.total_nights&gt;0&#10;AND NOT EXISTS (SELECT 1 FROM dw.Fact_Daily_Stay_Snapshot f WHERE f.booking_source_id=b.booking_source_id AND f.night_index=DATEDIFF(DAY,a.full_date,d.full_date)+1);&#10;SELECT @RowsInserted+@@ROWCOUNT;" SQLTask:ResultType="ResultSetType_SingleRow" SQLTask:TimeOut="0">
          <SQLTask:ParameterBinding SQLTask:ParameterName="0" SQLTask:DtsVariableName="User::BatchId" SQLTask:ParameterDirection="Input" SQLTask:DataType="3" SQLTask:ParameterSize="-1" />
          <SQLTask:ParameterBinding SQLTask:ParameterName="1" SQLTask:DtsVariableName="User::RowsInserted" SQLTask:ParameterDirection="Input" SQLTask:DataType="3" SQLTask:ParameterSize="-1" />
          <SQLTask:ResultBinding SQLTask:ResultName="0" SQLTask:DtsVariableName="User::RowsInserted" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable DTS:refId="Package\Check Fact Totals" DTS:CreationName="Microsoft.ExecuteSQLTask" DTS:ExecutableType="Microsoft.ExecuteSQLTask" DTS:DTSID="{04FE7D92-F0D3-4617-8707-FBC84F707CEC}" DTS:ObjectName="Check Fact Totals" DTS:DelayValidation="True">
      <DTS:ObjectData>
        <SQLTask:SqlTaskData SQLTask:Connection="{1D8E9115-018D-42D3-88CE-D18C406E4985}" SQLTask:SqlStatementSource="DECLARE @BatchId int = ?;&#10;IF (SELECT COUNT_BIG(*) FROM dw.Fact_Hotel_Booking WHERE batch_id=@BatchId) &lt;&gt; (SELECT COUNT_BIG(*) FROM stg.hotel_bookings_clean WHERE batch_id=@BatchId)&#10;    THROW 50051, 'Booking fact count does not match clean staging.',1;&#10;IF EXISTS (SELECT booking_source_id FROM dw.Fact_Hotel_Booking WHERE batch_id=@BatchId GROUP BY booking_source_id HAVING COUNT(*)&gt;1)&#10;    THROW 50052, 'Duplicate booking fact rows.',1;&#10;IF EXISTS (SELECT booking_source_id,night_index FROM dw.Fact_Daily_Stay_Snapshot WHERE batch_id=@BatchId GROUP BY booking_source_id,night_index HAVING COUNT(*)&gt;1)&#10;    THROW 50053, 'Duplicate daily stay rows.',1;&#10;IF EXISTS (SELECT 1 FROM stg.hotel_bookings_clean c LEFT HASH JOIN dw.Fact_Hotel_Booking b ON b.booking_source_id=c.staging_row_id AND b.batch_id=c.batch_id&#10;WHERE c.batch_id=@BatchId AND (b.booking_sk IS NULL OR b.total_nights&lt;&gt;c.total_nights OR b.estimated_revenue&lt;&gt;c.estimated_revenue OR b.actual_revenue&lt;&gt;c.actual_revenue OR b.lost_revenue&lt;&gt;c.lost_revenue))&#10;    THROW 50054, 'Booking fact values do not match clean staging.',1;&#10;IF EXISTS (SELECT 1 FROM stg.hotel_bookings_clean c LEFT HASH JOIN&#10;(SELECT booking_source_id,COUNT_BIG(*) AS nights,SUM(daily_revenue) AS revenue FROM dw.Fact_Daily_Stay_Snapshot&#10;WHERE batch_id=@BatchId GROUP BY booking_source_id) d ON d.booking_source_id=c.staging_row_id&#10;WHERE c.batch_id=@BatchId AND (COALESCE(d.nights,0)&lt;&gt;CASE WHEN c.is_canceled=0 THEN c.total_nights ELSE 0 END OR COALESCE(d.revenue,0)&lt;&gt;c.actual_revenue))&#10;    THROW 50055, 'Daily stay nights or revenue do not match clean staging.',1;&#10;IF EXISTS (SELECT 1 FROM dw.Fact_Daily_Stay_Snapshot f LEFT HASH JOIN stg.hotel_bookings_clean c ON c.staging_row_id=f.booking_source_id AND c.batch_id=f.batch_id&#10;LEFT HASH JOIN dw.Dim_Date d ON d.date_key=f.stay_date_key&#10;WHERE f.batch_id=@BatchId AND (c.staging_row_id IS NULL OR c.is_canceled=1 OR f.night_count&lt;&gt;1 OR f.night_index&lt;1 OR f.night_index&gt;c.total_nights OR f.daily_revenue&lt;&gt;c.adr&#10;OR d.full_date&lt;&gt;DATEADD(DAY,f.night_index-1,c.arrival_date) OR f.is_weekend_night&lt;&gt;d.is_weekend))&#10;    THROW 50056, 'Daily stay contains invalid booking or date values.',1;" SQLTask:ResultType="ResultSetType_None" SQLTask:TimeOut="0">
          <SQLTask:ParameterBinding SQLTask:ParameterName="0" SQLTask:DtsVariableName="User::BatchId" SQLTask:ParameterDirection="Input" SQLTask:DataType="3" SQLTask:ParameterSize="-1" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable DTS:refId="Package\Update Watermark and End Batch" DTS:CreationName="Microsoft.ExecuteSQLTask" DTS:ExecutableType="Microsoft.ExecuteSQLTask" DTS:DTSID="{5462E5AF-BC0E-41E9-A509-9CE08FFC2DAF}" DTS:ObjectName="Update Watermark and End Batch" DTS:DelayValidation="True">
      <DTS:ObjectData>
        <SQLTask:SqlTaskData SQLTask:Connection="{1D8E9115-018D-42D3-88CE-D18C406E4985}" SQLTask:SqlStatementSource="SET XACT_ABORT ON;&#10;DECLARE @BatchId int = ?, @RunBatchId int = ?, @RowsInserted int = ?;&#10;DECLARE @MaxDate date=(SELECT MAX(arrival_date) FROM stg.hotel_bookings_clean WHERE batch_id=@BatchId);&#10;BEGIN TRY&#10;BEGIN TRANSACTION;&#10;IF NOT EXISTS (SELECT 1 FROM meta.etl_watermark WHERE entity_name='hotel_bookings') THROW 50057, 'Hotel booking watermark is missing.',1;&#10;UPDATE meta.etl_watermark SET last_watermark_value=CONVERT(nvarchar(100),@MaxDate,23),last_batch_id=@BatchId,updated_at=SYSDATETIME()&#10;WHERE entity_name='hotel_bookings' AND (TRY_CONVERT(date,last_watermark_value,23) IS NULL OR TRY_CONVERT(date,last_watermark_value,23)&lt;=@MaxDate);&#10;UPDATE meta.etl_batch_log SET status='SUCCESS',end_time=SYSDATETIME(),&#10;rows_extracted=(SELECT COUNT(*) FROM stg.hotel_bookings_clean WHERE batch_id=@BatchId),rows_inserted=@RowsInserted WHERE batch_id=@RunBatchId;&#10;COMMIT TRANSACTION;&#10;END TRY&#10;BEGIN CATCH&#10;IF XACT_STATE()&lt;&gt;0 ROLLBACK TRANSACTION;&#10;THROW;&#10;END CATCH;" SQLTask:ResultType="ResultSetType_None" SQLTask:TimeOut="0">
          <SQLTask:ParameterBinding SQLTask:ParameterName="0" SQLTask:DtsVariableName="User::BatchId" SQLTask:ParameterDirection="Input" SQLTask:DataType="3" SQLTask:ParameterSize="-1" />
          <SQLTask:ParameterBinding SQLTask:ParameterName="1" SQLTask:DtsVariableName="User::RunBatchId" SQLTask:ParameterDirection="Input" SQLTask:DataType="3" SQLTask:ParameterSize="-1" />
          <SQLTask:ParameterBinding SQLTask:ParameterName="2" SQLTask:DtsVariableName="User::RowsInserted" SQLTask:ParameterDirection="Input" SQLTask:DataType="3" SQLTask:ParameterSize="-1" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
  <DTS:PrecedenceConstraints>
    <DTS:PrecedenceConstraint DTS:refId="Package.PrecedenceConstraints[{27DBC0F9-F2E8-4367-94F7-3A77A83BB4D3}]" DTS:CreationName="" DTS:DTSID="{65494559-28AD-4F89-B57A-A306DC7BC148}" DTS:ObjectName="Success" DTS:From="Package\Get Source Batch" DTS:To="Package\Start Batch" DTS:Value="0" DTS:LogicalAnd="True" />
    <DTS:PrecedenceConstraint DTS:refId="Package.PrecedenceConstraints[{53D3194B-165A-424D-854B-EB06535903A4}]" DTS:CreationName="" DTS:DTSID="{ECF1DB63-DFC8-480E-BE08-565D8C0456B5}" DTS:ObjectName="Success" DTS:From="Package\Start Batch" DTS:To="Package\Check Dimension Keys" DTS:Value="0" DTS:LogicalAnd="True" />
    <DTS:PrecedenceConstraint DTS:refId="Package.PrecedenceConstraints[{DF22C1C1-43B7-41AC-B5A6-C76C548AAE5C}]" DTS:CreationName="" DTS:DTSID="{1D798929-C8D8-480A-BCCF-93D04BD3D732}" DTS:ObjectName="Success" DTS:From="Package\Check Dimension Keys" DTS:To="Package\Load Booking Fact" DTS:Value="0" DTS:LogicalAnd="True" />
