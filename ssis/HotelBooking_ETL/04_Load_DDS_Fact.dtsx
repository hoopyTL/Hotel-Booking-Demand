      <DTS:Property DTS:Name="ParameterValue" DTS:DataType="8">Data Source=.\SQLEXPRESS;Initial Catalog=HotelBooking_DW;Provider=MSOLEDBSQL;Integrated Security=SSPI;Trust Server Certificate=True;</DTS:Property>
    </DTS:PackageParameter>
  </DTS:PackageParameters>
  <DTS:Variables>
    <DTS:Variable DTS:DTSID="{0689318A-4944-416A-B4CE-100D73992E3F}" DTS:Namespace="User" DTS:ObjectName="BatchId">
