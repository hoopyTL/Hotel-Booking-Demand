    <DTS:ConnectionManager DTS:refId="Package.ConnectionManagers[SQL Server Connection]" DTS:CreationName="OLEDB" DTS:DTSID="{1D8E9115-018D-42D3-88CE-D18C406E4985}" DTS:ObjectName="SQL Server Connection">
      <DTS:PropertyExpression DTS:Name="ConnectionString">@[$Package::SqlConnectionString]</DTS:PropertyExpression>
