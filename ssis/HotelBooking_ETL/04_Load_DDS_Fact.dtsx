    <DTS:Executable DTS:refId="Package\Check Fact Totals" DTS:CreationName="Microsoft.ExecuteSQLTask" DTS:ExecutableType="Microsoft.ExecuteSQLTask" DTS:DTSID="{04FE7D92-F0D3-4617-8707-FBC84F707CEC}" DTS:ObjectName="Check Fact Totals" DTS:DelayValidation="True">
      <DTS:ObjectData>
        <SQLTask:SqlTaskData SQLTask:Connection="{1D8E9115-018D-42D3-88CE-D18C406E4985}" SQLTask:SqlStatementSource="DECLARE @BatchId int = ?;&#10;IF (SELECT COUNT_BIG(*) FROM dw.Fact_Hotel_Booking WHERE batch_id=@BatchId) &lt;&gt; (SELECT COUNT_BIG(*) FROM stg.hotel_bookings_clean WHERE batch_id=@BatchId) THROW 50051, 'Booking fact count does not match clean staging.',1;&#10;IF EXISTS (SELECT booking_source_id FROM dw.Fact_Hotel_Booking WHERE batch_id=@BatchId GROUP BY booking_source_id HAVING COUNT(*)&gt;1) THROW 50052, 'Duplicate booking fact rows.',1;&#10;IF EXISTS (SELECT 1 FROM stg.hotel_bookings_clean c LEFT HASH JOIN (SELECT booking_source_id, COUNT_BIG(*) AS nights, SUM(daily_revenue) AS revenue FROM dw.Fact_Daily_Stay_Snapshot WHERE batch_id=@BatchId GROUP BY booking_source_id) d ON d.booking_source_id=c.staging_row_id WHERE c.batch_id=@BatchId AND (COALESCE(d.nights,0)&lt;&gt;CASE WHEN c.is_canceled=0 THEN c.total_nights ELSE 0 END OR COALESCE(d.revenue,0)&lt;&gt;c.actual_revenue)) THROW 50055, 'Daily stay nights or revenue do not match clean staging.',1;" SQLTask:ResultType="ResultSetType_None" SQLTask:TimeOut="0">
          <SQLTask:ParameterBinding SQLTask:ParameterName="0" SQLTask:DtsVariableName="User::BatchId" SQLTask:ParameterDirection="Input" SQLTask:DataType="3" SQLTask:ParameterSize="-1" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable DTS:refId="Package\Update Watermark and End Batch" DTS:CreationName="Microsoft.ExecuteSQLTask" DTS:ExecutableType="Microsoft.ExecuteSQLTask" DTS:DTSID="{5462E5AF-BC0E-41E9-A509-9CE08FFC2DAF}" DTS:ObjectName="Update Watermark and End Batch" DTS:DelayValidation="True">
      <DTS:ObjectData>
        <SQLTask:SqlTaskData SQLTask:Connection="{1D8E9115-018D-42D3-88CE-D18C406E4985}" SQLTask:SqlStatementSource="SET XACT_ABORT ON;&#10;DECLARE @BatchId int = ?, @RunBatchId int = ?, @RowsInserted int = ?;&#10;DECLARE @MaxDate date=(SELECT MAX(arrival_date) FROM stg.hotel_bookings_clean WHERE batch_id=@BatchId);&#10;BEGIN TRY&#10;BEGIN TRANSACTION;&#10;IF NOT EXISTS (SELECT 1 FROM meta.etl_watermark WHERE entity_name='hotel_bookings') THROW 50057, 'Hotel booking watermark is missing.',1;&#10;UPDATE meta.etl_watermark SET last_watermark_value=CONVERT(nvarchar(100),@MaxDate,23),last_batch_id=@BatchId,updated_at=SYSDATETIME() WHERE entity_name='hotel_bookings' AND (TRY_CONVERT(date,last_watermark_value,23) IS NULL OR TRY_CONVERT(date,last_watermark_value,23)&lt;=@MaxDate);&#10;UPDATE meta.etl_batch_log SET status='SUCCESS',end_time=SYSDATETIME(),rows_extracted=(SELECT COUNT(*) FROM stg.hotel_bookings_clean WHERE batch_id=@BatchId),rows_inserted=@RowsInserted WHERE batch_id=@RunBatchId;&#10;COMMIT TRANSACTION;&#10;END TRY&#10;BEGIN CATCH&#10;IF XACT_STATE()&lt;&gt;0 ROLLBACK TRANSACTION;&#10;THROW;&#10;END CATCH;" SQLTask:ResultType="ResultSetType_None" SQLTask:TimeOut="0">
          <SQLTask:ParameterBinding SQLTask:ParameterName="0" SQLTask:DtsVariableName="User::BatchId" SQLTask:ParameterDirection="Input" SQLTask:DataType="3" SQLTask:ParameterSize="-1" />
          <SQLTask:ParameterBinding SQLTask:ParameterName="1" SQLTask:DtsVariableName="User::RunBatchId" SQLTask:ParameterDirection="Input" SQLTask:DataType="3" SQLTask:ParameterSize="-1" />
          <SQLTask:ParameterBinding SQLTask:ParameterName="2" SQLTask:DtsVariableName="User::RowsInserted" SQLTask:ParameterDirection="Input" SQLTask:DataType="3" SQLTask:ParameterSize="-1" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
