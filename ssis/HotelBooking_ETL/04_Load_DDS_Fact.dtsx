    </DTS:ConnectionManager>
  </DTS:ConnectionManagers>
  <DTS:Executables>
    <DTS:Executable DTS:refId="Package\Get Source Batch" DTS:CreationName="Microsoft.ExecuteSQLTask" DTS:ExecutableType="Microsoft.ExecuteSQLTask" DTS:DTSID="{54FA6661-56B8-48F9-9E7C-0C9C393B4BF8}" DTS:ObjectName="Get Source Batch" DTS:DelayValidation="True">
      <DTS:ObjectData>
        <SQLTask:SqlTaskData SQLTask:Connection="{1D8E9115-018D-42D3-88CE-D18C406E4985}" SQLTask:SqlStatementSource="SET NOCOUNT ON;&#10;DECLARE @BatchId int = ?;&#10;IF @BatchId=0 SELECT @BatchId=MAX(l.batch_id) FROM meta.etl_batch_log l WHERE l.package_name='01_Ingest_CSV_To_RawStaging' AND l.status='SUCCESS' AND EXISTS (SELECT 1 FROM stg.hotel_bookings_clean c WHERE c.batch_id=l.batch_id);&#10;IF @BatchId IS NULL OR NOT EXISTS (SELECT 1 FROM meta.etl_batch_log WHERE batch_id=@BatchId AND package_name='01_Ingest_CSV_To_RawStaging' AND status='SUCCESS') THROW 50040, 'No valid source batch. Run packages 01 and 02 first.',1;&#10;IF NOT EXISTS (SELECT 1 FROM stg.hotel_bookings_clean WHERE batch_id=@BatchId) THROW 50041, 'Source batch has no clean rows. Run package 02 first.',1;&#10;SELECT @BatchId;" SQLTask:ResultType="ResultSetType_SingleRow" SQLTask:TimeOut="0">
          <SQLTask:ParameterBinding SQLTask:ParameterName="0" SQLTask:DtsVariableName="$Package::SourceBatchId" SQLTask:ParameterDirection="Input" SQLTask:DataType="3" SQLTask:ParameterSize="-1" />
          <SQLTask:ResultBinding SQLTask:ResultName="0" SQLTask:DtsVariableName="User::BatchId" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable DTS:refId="Package\Start Batch" DTS:CreationName="Microsoft.ExecuteSQLTask" DTS:ExecutableType="Microsoft.ExecuteSQLTask" DTS:DTSID="{5CF50636-1BF8-40D6-B414-C60431DAC550}" DTS:ObjectName="Start Batch" DTS:DelayValidation="True">
      <DTS:ObjectData>
        <SQLTask:SqlTaskData SQLTask:Connection="{1D8E9115-018D-42D3-88CE-D18C406E4985}" SQLTask:SqlStatementSource="SET NOCOUNT ON;&#10;DECLARE @SourceBatchId int = ?;&#10;INSERT INTO meta.etl_batch_log(package_name,load_type,source_file,status) SELECT '04_Load_DDS_Fact',load_type,source_file,'RUNNING' FROM meta.etl_batch_log WHERE batch_id=@SourceBatchId;&#10;SELECT CAST(SCOPE_IDENTITY() AS int);" SQLTask:ResultType="ResultSetType_SingleRow" SQLTask:TimeOut="0">
          <SQLTask:ParameterBinding SQLTask:ParameterName="0" SQLTask:DtsVariableName="User::BatchId" SQLTask:ParameterDirection="Input" SQLTask:DataType="3" SQLTask:ParameterSize="-1" />
          <SQLTask:ResultBinding SQLTask:ResultName="0" SQLTask:DtsVariableName="User::RunBatchId" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable DTS:refId="Package\Check Dimension Keys" DTS:CreationName="Microsoft.ExecuteSQLTask" DTS:ExecutableType="Microsoft.ExecuteSQLTask" DTS:DTSID="{82DB15F0-775A-492E-8456-CB043EB4B7BD}" DTS:ObjectName="Check Dimension Keys" DTS:DelayValidation="True">
      <DTS:ObjectData>
        <SQLTask:SqlTaskData SQLTask:Connection="{1D8E9115-018D-42D3-88CE-D18C406E4985}" SQLTask:SqlStatementSource="DECLARE @BatchId int = ?;&#10;IF EXISTS (SELECT 1 FROM stg.hotel_bookings_clean c WHERE c.batch_id=@BatchId AND c.is_canceled=0 AND c.total_nights&gt;0 AND NOT EXISTS (SELECT 1 FROM dw.Dim_Date d WHERE d.full_date=DATEADD(DAY,c.total_nights-1,c.arrival_date))) THROW 50050, 'Stay dates are missing. Run package 03 first.',1;" SQLTask:ResultType="ResultSetType_None" SQLTask:TimeOut="0">
          <SQLTask:ParameterBinding SQLTask:ParameterName="0" SQLTask:DtsVariableName="User::BatchId" SQLTask:ParameterDirection="Input" SQLTask:DataType="3" SQLTask:ParameterSize="-1" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
