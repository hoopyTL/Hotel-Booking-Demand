      <DTS:ObjectData>
        <ExecutePackageTask>
          <UseProjectReference>True</UseProjectReference>
          <PackageName>01_Ingest_CSV_To_RawStaging.dtsx</PackageName>
          <ParameterAssignment>
            <ParameterName>SourceFile</ParameterName>
