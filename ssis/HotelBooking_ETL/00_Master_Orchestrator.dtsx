  <DTS:Executables>
    <DTS:Executable DTS:refId="Package\Start Pipeline" DTS:CreationName="Microsoft.ExecuteSQLTask" DTS:ExecutableType="Microsoft.ExecuteSQLTask" DTS:DTSID="{21B5BF09-460B-4E80-86F0-AD938860976E}" DTS:ObjectName="Start Pipeline" DTS:DelayValidation="True">
      <DTS:ObjectData>
        <SQLTask:SqlTaskData SQLTask:Connection="{12A79521-AB9E-4053-9263-117A67C2A32C}" SQLTask:SqlStatementSource="SET NOCOUNT ON;&#10;DECLARE @LoadType varchar(20) = ?, @SourceFile nvarchar(255) = ?;&#10;IF @LoadType NOT IN ('FULL','INCREMENTAL') THROW 50060, 'LoadType must be FULL or INCREMENTAL.',1;&#10;IF NULLIF(LTRIM(RTRIM(@SourceFile)),'') IS NULL THROW 50061, 'SourceFile is required.',1;&#10;IF @LoadType='INCREMENTAL' AND EXISTS (SELECT 1 FROM meta.etl_batch_log WHERE package_name='01_Ingest_CSV_To_RawStaging' AND status='SUCCESS' AND source_file=@SourceFile AND batch_id &gt; ISNULL((SELECT MAX(batch_id) FROM meta.etl_batch_log WHERE package_name='01_Ingest_CSV_To_RawStaging' AND load_type='FULL' AND status='SUCCESS'), 0))&#10;    THROW 50062, 'This incremental file was already loaded successfully.',1;&#10;INSERT INTO meta.etl_batch_log(package_name,load_type,source_file,status) VALUES('00_Master_Orchestrator',@LoadType,@SourceFile,'RUNNING');&#10;SELECT CAST(SCOPE_IDENTITY() AS int);" SQLTask:ResultType="ResultSetType_SingleRow" SQLTask:TimeOut="0">
          <SQLTask:ParameterBinding SQLTask:ParameterName="0" SQLTask:DtsVariableName="$Package::LoadType" SQLTask:ParameterDirection="Input" SQLTask:DataType="129" SQLTask:ParameterSize="20" />
          <SQLTask:ParameterBinding SQLTask:ParameterName="1" SQLTask:DtsVariableName="$Package::SourceFile" SQLTask:ParameterDirection="Input" SQLTask:DataType="130" SQLTask:ParameterSize="255" />
          <SQLTask:ResultBinding SQLTask:ResultName="0" SQLTask:DtsVariableName="User::RunBatchId" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable DTS:refId="Package\Prepare Full Load" DTS:CreationName="Microsoft.ExecuteSQLTask" DTS:ExecutableType="Microsoft.ExecuteSQLTask" DTS:DTSID="{8D04AD46-E7E7-4DFE-8109-7BB148685810}" DTS:ObjectName="Prepare Full Load" DTS:DelayValidation="True">
      <DTS:ObjectData>
        <SQLTask:SqlTaskData SQLTask:Connection="{12A79521-AB9E-4053-9263-117A67C2A32C}" SQLTask:SqlStatementSource="SET XACT_ABORT ON;&#10;DECLARE @LoadType varchar(20) = ?;&#10;IF @LoadType='FULL'&#10;BEGIN&#10;    BEGIN TRY&#10;    BEGIN TRANSACTION;&#10;    DELETE FROM dw.Fact_Daily_Stay_Snapshot;&#10;    DELETE FROM dw.Fact_Hotel_Booking;&#10;    DELETE FROM stg.hotel_bookings_clean;&#10;    DELETE FROM stg.hotel_bookings_error;&#10;    UPDATE meta.etl_watermark SET last_watermark_value='1900-01-01',last_batch_id=NULL,updated_at=SYSDATETIME() WHERE entity_name='hotel_bookings';&#10;    COMMIT TRANSACTION;&#10;    END TRY&#10;    BEGIN CATCH&#10;        IF XACT_STATE()&lt;&gt;0 ROLLBACK TRANSACTION;&#10;        THROW;&#10;    END CATCH;&#10;END;" SQLTask:ResultType="ResultSetType_None" SQLTask:TimeOut="0">
          <SQLTask:ParameterBinding SQLTask:ParameterName="0" SQLTask:DtsVariableName="$Package::LoadType" SQLTask:ParameterDirection="Input" SQLTask:DataType="129" SQLTask:ParameterSize="20" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
