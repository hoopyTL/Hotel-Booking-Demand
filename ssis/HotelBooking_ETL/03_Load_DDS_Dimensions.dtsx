            <SQLTask:SqlTaskData SQLTask:Connection="{21CC28A4-985D-485C-9B9A-58B866F584C8}" SQLTask:SqlStatementSource="DECLARE @RunBatchId int = ?, @Message nvarchar(4000) = ?, @RowsInserted int = ?; IF @RunBatchId&gt;0 UPDATE meta.etl_batch_log SET status='FAILED',end_time=SYSDATETIME(),rows_inserted=@RowsInserted,error_message=@Message WHERE batch_id=@RunBatchId;" SQLTask:ResultType="ResultSetType_None" SQLTask:TimeOut="0">
