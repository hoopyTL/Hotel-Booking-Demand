  <DTS:Executables>
    <DTS:Executable DTS:refId="Package\Get Source Batch" DTS:CreationName="Microsoft.ExecuteSQLTask" DTS:ExecutableType="Microsoft.ExecuteSQLTask" DTS:DTSID="{84A49163-A058-4F2A-87F6-52D56B8DFC3A}" DTS:ObjectName="Get Source Batch" DTS:DelayValidation="True">
      <DTS:ObjectData>
        <SQLTask:SqlTaskData SQLTask:Connection="{21CC28A4-985D-485C-9B9A-58B866F584C8}" SQLTask:SqlStatementSource="SET NOCOUNT ON;&#10;DECLARE @BatchId int = ?;&#10;IF @BatchId=0 SELECT @BatchId=MAX(l.batch_id) FROM meta.etl_batch_log l&#10;WHERE l.package_name='01_Ingest_CSV_To_RawStaging' AND l.status='SUCCESS'&#10;AND EXISTS (SELECT 1 FROM stg.hotel_bookings_clean c WHERE c.batch_id=l.batch_id);&#10;IF @BatchId IS NULL OR NOT EXISTS (SELECT 1 FROM meta.etl_batch_log WHERE batch_id=@BatchId AND package_name='01_Ingest_CSV_To_RawStaging' AND status='SUCCESS')&#10;    THROW 50040, 'No valid source batch. Run packages 01 and 02 first.',1;&#10;IF NOT EXISTS (SELECT 1 FROM stg.hotel_bookings_clean WHERE batch_id=@BatchId)&#10;    THROW 50041, 'Source batch has no clean rows. Run package 02 first.',1;&#10;IF (SELECT COUNT(*) FROM stg.hotel_bookings_raw WHERE batch_id=@BatchId) &lt;&gt;&#10;   (SELECT COUNT(*) FROM stg.hotel_bookings_clean WHERE batch_id=@BatchId) +&#10;   (SELECT COUNT(*) FROM stg.hotel_bookings_error WHERE batch_id=@BatchId)&#10;    THROW 50042, 'Clean staging row counts do not match source batch.',1;&#10;SELECT @BatchId;" SQLTask:ResultType="ResultSetType_SingleRow" SQLTask:TimeOut="0">
          <SQLTask:ParameterBinding SQLTask:ParameterName="0" SQLTask:DtsVariableName="$Package::SourceBatchId" SQLTask:ParameterDirection="Input" SQLTask:DataType="3" SQLTask:ParameterSize="-1" />
          <SQLTask:ResultBinding SQLTask:ResultName="0" SQLTask:DtsVariableName="User::BatchId" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable DTS:refId="Package\Start Batch" DTS:CreationName="Microsoft.ExecuteSQLTask" DTS:ExecutableType="Microsoft.ExecuteSQLTask" DTS:DTSID="{EAC7305B-8B29-4A22-96AE-D0FCB2EE950A}" DTS:ObjectName="Start Batch" DTS:DelayValidation="True">
      <DTS:ObjectData>
        <SQLTask:SqlTaskData SQLTask:Connection="{21CC28A4-985D-485C-9B9A-58B866F584C8}" SQLTask:SqlStatementSource="SET NOCOUNT ON;&#10;DECLARE @SourceBatchId int = ?;&#10;INSERT INTO meta.etl_batch_log(package_name,load_type,source_file,status)&#10;SELECT '03_Load_DDS_Dimensions',load_type,source_file,'RUNNING' FROM meta.etl_batch_log WHERE batch_id=@SourceBatchId;&#10;SELECT CAST(SCOPE_IDENTITY() AS int);" SQLTask:ResultType="ResultSetType_SingleRow" SQLTask:TimeOut="0">
          <SQLTask:ParameterBinding SQLTask:ParameterName="0" SQLTask:DtsVariableName="User::BatchId" SQLTask:ParameterDirection="Input" SQLTask:DataType="3" SQLTask:ParameterSize="-1" />
          <SQLTask:ResultBinding SQLTask:ResultName="0" SQLTask:DtsVariableName="User::RunBatchId" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable DTS:refId="Package\Load Date" DTS:CreationName="Microsoft.ExecuteSQLTask" DTS:ExecutableType="Microsoft.ExecuteSQLTask" DTS:DTSID="{2FF0CB30-3972-4DFA-8045-13C44AC54F10}" DTS:ObjectName="Load Date" DTS:DelayValidation="True">
      <DTS:ObjectData>
        <SQLTask:SqlTaskData SQLTask:Connection="{21CC28A4-985D-485C-9B9A-58B866F584C8}" SQLTask:SqlStatementSource="SET NOCOUNT ON;&#10;SET LANGUAGE us_english;&#10;SET DATEFIRST 1;&#10;DECLARE @BatchId int = ?, @RowsInserted int = ?;&#10;DECLARE @StartDate date='2013-01-01',@EndDate date='2018-12-31';&#10;SELECT @StartDate=CASE WHEN MIN(d.dt)&lt;@StartDate THEN MIN(d.dt) ELSE @StartDate END,&#10;       @EndDate=CASE WHEN MAX(d.dt)&gt;@EndDate THEN MAX(d.dt) ELSE @EndDate END&#10;FROM stg.hotel_bookings_clean c CROSS APPLY (VALUES(c.arrival_date),(c.booking_date),(c.reservation_status_date),&#10;    (DATEADD(DAY,c.total_nights,c.arrival_date))) d(dt) WHERE c.batch_id=@BatchId;&#10;;WITH Dates AS (SELECT @StartDate AS dt UNION ALL SELECT DATEADD(DAY,1,dt) FROM Dates WHERE dt&lt;@EndDate)&#10;INSERT INTO dw.Dim_Date(date_key,full_date,day_of_month,day_of_week,day_name,is_weekend,week_of_year,month_number,month_name,quarter,year,season)&#10;SELECT CONVERT(int,CONVERT(char(8),dt,112)),dt,DAY(dt),DATEPART(WEEKDAY,dt),DATENAME(WEEKDAY,dt),&#10;CASE WHEN DATEPART(WEEKDAY,dt) IN(6,7) THEN 1 ELSE 0 END,DATEPART(ISO_WEEK,dt),MONTH(dt),DATENAME(MONTH,dt),DATEPART(QUARTER,dt),YEAR(dt),&#10;CASE WHEN MONTH(dt) IN(12,1,2) THEN 'Winter' WHEN MONTH(dt) IN(3,4,5) THEN 'Spring' WHEN MONTH(dt) IN(6,7,8) THEN 'Summer' ELSE 'Autumn' END&#10;FROM Dates WHERE NOT EXISTS (SELECT 1 FROM dw.Dim_Date d WHERE d.full_date=Dates.dt) OPTION(MAXRECURSION 0);&#10;SELECT @RowsInserted+@@ROWCOUNT;" SQLTask:ResultType="ResultSetType_SingleRow" SQLTask:TimeOut="0">
          <SQLTask:ParameterBinding SQLTask:ParameterName="0" SQLTask:DtsVariableName="User::BatchId" SQLTask:ParameterDirection="Input" SQLTask:DataType="3" SQLTask:ParameterSize="-1" />
          <SQLTask:ParameterBinding SQLTask:ParameterName="1" SQLTask:DtsVariableName="User::RowsInserted" SQLTask:ParameterDirection="Input" SQLTask:DataType="3" SQLTask:ParameterSize="-1" />
          <SQLTask:ResultBinding SQLTask:ResultName="0" SQLTask:DtsVariableName="User::RowsInserted" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable DTS:refId="Package\Load Hotel" DTS:CreationName="Microsoft.ExecuteSQLTask" DTS:ExecutableType="Microsoft.ExecuteSQLTask" DTS:DTSID="{95A9B6DB-493B-409F-B34C-9EEBB2539561}" DTS:ObjectName="Load Hotel" DTS:DelayValidation="True">
      <DTS:ObjectData>
        <SQLTask:SqlTaskData SQLTask:Connection="{21CC28A4-985D-485C-9B9A-58B866F584C8}" SQLTask:SqlStatementSource="SET NOCOUNT ON;&#10;DECLARE @BatchId int = ?, @RowsInserted int = ?;&#10;INSERT INTO [dw].[Dim_Hotel] ([hotel_code], [hotel_name], [city], [country])&#10;    SELECT DISTINCT&#10;        CASE WHEN c.[hotel] = 'Resort Hotel' THEN 'H1' ELSE 'H2' END,&#10;        c.[hotel],&#10;        CASE WHEN c.[hotel] = 'Resort Hotel' THEN 'Algarve' ELSE 'Lisbon' END,&#10;        'Portugal'&#10;    FROM [stg].[hotel_bookings_clean] c&#10;    WHERE c.[batch_id] = @BatchId&#10;      AND NOT EXISTS (SELECT 1 FROM [dw].[Dim_Hotel] d WHERE d.[hotel_name] = c.[hotel]);&#10;SELECT @RowsInserted+@@ROWCOUNT;" SQLTask:ResultType="ResultSetType_SingleRow" SQLTask:TimeOut="0">
          <SQLTask:ParameterBinding SQLTask:ParameterName="0" SQLTask:DtsVariableName="User::BatchId" SQLTask:ParameterDirection="Input" SQLTask:DataType="3" SQLTask:ParameterSize="-1" />
          <SQLTask:ParameterBinding SQLTask:ParameterName="1" SQLTask:DtsVariableName="User::RowsInserted" SQLTask:ParameterDirection="Input" SQLTask:DataType="3" SQLTask:ParameterSize="-1" />
          <SQLTask:ResultBinding SQLTask:ResultName="0" SQLTask:DtsVariableName="User::RowsInserted" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable DTS:refId="Package\Load Country" DTS:CreationName="Microsoft.ExecuteSQLTask" DTS:ExecutableType="Microsoft.ExecuteSQLTask" DTS:DTSID="{B2BE7162-9CF3-4C93-9B16-FBDB312A41D6}" DTS:ObjectName="Load Country" DTS:DelayValidation="True">
      <DTS:ObjectData>
        <SQLTask:SqlTaskData SQLTask:Connection="{21CC28A4-985D-485C-9B9A-58B866F584C8}" SQLTask:SqlStatementSource="SET NOCOUNT ON;&#10;DECLARE @BatchId int = ?, @RowsInserted int = ?;&#10;INSERT INTO [dw].[Dim_Country] ([country_iso3], [country_name], [region])&#10;    SELECT DISTINCT&#10;        c.[country],&#10;        CASE WHEN c.[country] = 'UNK' THEN N'Unknown' ELSE c.[country] END,&#10;        N'Unclassified'&#10;    FROM [stg].[hotel_bookings_clean] c&#10;    WHERE c.[batch_id] = @BatchId&#10;      AND NOT EXISTS (SELECT 1 FROM [dw].[Dim_Country] d WHERE d.[country_iso3] = c.[country]);&#10;SELECT @RowsInserted+@@ROWCOUNT;" SQLTask:ResultType="ResultSetType_SingleRow" SQLTask:TimeOut="0">
          <SQLTask:ParameterBinding SQLTask:ParameterName="0" SQLTask:DtsVariableName="User::BatchId" SQLTask:ParameterDirection="Input" SQLTask:DataType="3" SQLTask:ParameterSize="-1" />
          <SQLTask:ParameterBinding SQLTask:ParameterName="1" SQLTask:DtsVariableName="User::RowsInserted" SQLTask:ParameterDirection="Input" SQLTask:DataType="3" SQLTask:ParameterSize="-1" />
          <SQLTask:ResultBinding SQLTask:ResultName="0" SQLTask:DtsVariableName="User::RowsInserted" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable DTS:refId="Package\Load Market Segment" DTS:CreationName="Microsoft.ExecuteSQLTask" DTS:ExecutableType="Microsoft.ExecuteSQLTask" DTS:DTSID="{E063D760-77B1-47FA-87C2-9BF51D7ECE3F}" DTS:ObjectName="Load Market Segment" DTS:DelayValidation="True">
      <DTS:ObjectData>
        <SQLTask:SqlTaskData SQLTask:Connection="{21CC28A4-985D-485C-9B9A-58B866F584C8}" SQLTask:SqlStatementSource="SET NOCOUNT ON;&#10;DECLARE @BatchId int = ?, @RowsInserted int = ?;&#10;INSERT INTO [dw].[Dim_Market_Segment] ([market_segment_name], [segment_group])&#10;    SELECT DISTINCT&#10;        c.[market_segment],&#10;        CASE&#10;            WHEN c.[market_segment] IN ('Online TA', 'Offline TA/TO') THEN 'Travel Agency / Operator'&#10;            WHEN c.[market_segment] = 'Direct' THEN 'Direct'&#10;            WHEN c.[market_segment] IN ('Corporate', 'Aviation') THEN 'B2B / Corporate'&#10;            WHEN c.[market_segment] = 'Groups' THEN 'Groups'&#10;            ELSE 'Other / Complementary'&#10;        END&#10;    FROM [stg].[hotel_bookings_clean] c&#10;    WHERE c.[batch_id] = @BatchId&#10;      AND NOT EXISTS (SELECT 1 FROM [dw].[Dim_Market_Segment] d WHERE d.[market_segment_name] = c.[market_segment]);&#10;SELECT @RowsInserted+@@ROWCOUNT;" SQLTask:ResultType="ResultSetType_SingleRow" SQLTask:TimeOut="0">
          <SQLTask:ParameterBinding SQLTask:ParameterName="0" SQLTask:DtsVariableName="User::BatchId" SQLTask:ParameterDirection="Input" SQLTask:DataType="3" SQLTask:ParameterSize="-1" />
          <SQLTask:ParameterBinding SQLTask:ParameterName="1" SQLTask:DtsVariableName="User::RowsInserted" SQLTask:ParameterDirection="Input" SQLTask:DataType="3" SQLTask:ParameterSize="-1" />
          <SQLTask:ResultBinding SQLTask:ResultName="0" SQLTask:DtsVariableName="User::RowsInserted" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable DTS:refId="Package\Load Distribution Channel" DTS:CreationName="Microsoft.ExecuteSQLTask" DTS:ExecutableType="Microsoft.ExecuteSQLTask" DTS:DTSID="{C673F7B7-E2E3-4C09-AC5C-7B0345F8674A}" DTS:ObjectName="Load Distribution Channel" DTS:DelayValidation="True">
      <DTS:ObjectData>
        <SQLTask:SqlTaskData SQLTask:Connection="{21CC28A4-985D-485C-9B9A-58B866F584C8}" SQLTask:SqlStatementSource="SET NOCOUNT ON;&#10;DECLARE @BatchId int = ?, @RowsInserted int = ?;&#10;INSERT INTO [dw].[Dim_Distribution_Channel] ([distribution_channel_name])&#10;    SELECT DISTINCT c.[distribution_channel]&#10;    FROM [stg].[hotel_bookings_clean] c&#10;    WHERE c.[batch_id] = @BatchId&#10;      AND NOT EXISTS (SELECT 1 FROM [dw].[Dim_Distribution_Channel] d WHERE d.[distribution_channel_name] = c.[distribution_channel]);&#10;SELECT @RowsInserted+@@ROWCOUNT;" SQLTask:ResultType="ResultSetType_SingleRow" SQLTask:TimeOut="0">
          <SQLTask:ParameterBinding SQLTask:ParameterName="0" SQLTask:DtsVariableName="User::BatchId" SQLTask:ParameterDirection="Input" SQLTask:DataType="3" SQLTask:ParameterSize="-1" />
          <SQLTask:ParameterBinding SQLTask:ParameterName="1" SQLTask:DtsVariableName="User::RowsInserted" SQLTask:ParameterDirection="Input" SQLTask:DataType="3" SQLTask:ParameterSize="-1" />
          <SQLTask:ResultBinding SQLTask:ResultName="0" SQLTask:DtsVariableName="User::RowsInserted" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable DTS:refId="Package\Load Room Type" DTS:CreationName="Microsoft.ExecuteSQLTask" DTS:ExecutableType="Microsoft.ExecuteSQLTask" DTS:DTSID="{6F824C60-8489-47EB-B98E-B82F44121ECE}" DTS:ObjectName="Load Room Type" DTS:DelayValidation="True">
      <DTS:ObjectData>
        <SQLTask:SqlTaskData SQLTask:Connection="{21CC28A4-985D-485C-9B9A-58B866F584C8}" SQLTask:SqlStatementSource="SET NOCOUNT ON;&#10;DECLARE @BatchId int = ?, @RowsInserted int = ?;&#10;INSERT INTO [dw].[Dim_Room_Type] ([room_type_code])&#10;    SELECT DISTINCT RoomCode&#10;    FROM (&#10;        SELECT [reserved_room_type] AS RoomCode FROM [stg].[hotel_bookings_clean] WHERE [batch_id] = @BatchId&#10;        UNION&#10;        SELECT [assigned_room_type] AS RoomCode FROM [stg].[hotel_bookings_clean] WHERE [batch_id] = @BatchId&#10;    ) r&#10;    WHERE NOT EXISTS (SELECT 1 FROM [dw].[Dim_Room_Type] d WHERE d.[room_type_code] = r.RoomCode);&#10;SELECT @RowsInserted+@@ROWCOUNT;" SQLTask:ResultType="ResultSetType_SingleRow" SQLTask:TimeOut="0">
          <SQLTask:ParameterBinding SQLTask:ParameterName="0" SQLTask:DtsVariableName="User::BatchId" SQLTask:ParameterDirection="Input" SQLTask:DataType="3" SQLTask:ParameterSize="-1" />
          <SQLTask:ParameterBinding SQLTask:ParameterName="1" SQLTask:DtsVariableName="User::RowsInserted" SQLTask:ParameterDirection="Input" SQLTask:DataType="3" SQLTask:ParameterSize="-1" />
          <SQLTask:ResultBinding SQLTask:ResultName="0" SQLTask:DtsVariableName="User::RowsInserted" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable DTS:refId="Package\Load Booking Profile" DTS:CreationName="Microsoft.ExecuteSQLTask" DTS:ExecutableType="Microsoft.ExecuteSQLTask" DTS:DTSID="{EB3BCDA2-512B-4120-9C7E-743C3572CAAB}" DTS:ObjectName="Load Booking Profile" DTS:DelayValidation="True">
      <DTS:ObjectData>
        <SQLTask:SqlTaskData SQLTask:Connection="{21CC28A4-985D-485C-9B9A-58B866F584C8}" SQLTask:SqlStatementSource="SET NOCOUNT ON;&#10;DECLARE @BatchId int = ?, @RowsInserted int = ?;&#10;INSERT INTO [dw].[Dim_Booking_Profile] (&#10;        [customer_type], [deposit_type], [meal_code], [meal_description], [is_repeated_guest]&#10;    )&#10;    SELECT DISTINCT&#10;        c.[customer_type],&#10;        c.[deposit_type],&#10;        c.[meal],&#10;        CASE c.[meal]&#10;            WHEN 'BB' THEN 'Bed &amp; Breakfast'&#10;            WHEN 'HB' THEN 'Half Board (Breakfast + 1 Meal)'&#10;            WHEN 'FB' THEN 'Full Board (Breakfast, Lunch, Dinner)'&#10;            ELSE 'Self Catering / No Meal Package'&#10;        END,&#10;        c.[is_repeated_guest]&#10;    FROM [stg].[hotel_bookings_clean] c&#10;    WHERE c.[batch_id] = @BatchId&#10;      AND NOT EXISTS (&#10;          SELECT 1 FROM [dw].[Dim_Booking_Profile] d&#10;          WHERE d.[customer_type]     = c.[customer_type]&#10;            AND d.[deposit_type]      = c.[deposit_type]&#10;            AND d.[meal_code]         = c.[meal]&#10;            AND d.[is_repeated_guest] = c.[is_repeated_guest]&#10;      );&#10;SELECT @RowsInserted+@@ROWCOUNT;" SQLTask:ResultType="ResultSetType_SingleRow" SQLTask:TimeOut="0">
          <SQLTask:ParameterBinding SQLTask:ParameterName="0" SQLTask:DtsVariableName="User::BatchId" SQLTask:ParameterDirection="Input" SQLTask:DataType="3" SQLTask:ParameterSize="-1" />
          <SQLTask:ParameterBinding SQLTask:ParameterName="1" SQLTask:DtsVariableName="User::RowsInserted" SQLTask:ParameterDirection="Input" SQLTask:DataType="3" SQLTask:ParameterSize="-1" />
          <SQLTask:ResultBinding SQLTask:ResultName="0" SQLTask:DtsVariableName="User::RowsInserted" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable DTS:refId="Package\Load Reservation Status" DTS:CreationName="Microsoft.ExecuteSQLTask" DTS:ExecutableType="Microsoft.ExecuteSQLTask" DTS:DTSID="{89F0F08B-9063-4938-8F71-5AF6224FD1CA}" DTS:ObjectName="Load Reservation Status" DTS:DelayValidation="True">
      <DTS:ObjectData>
        <SQLTask:SqlTaskData SQLTask:Connection="{21CC28A4-985D-485C-9B9A-58B866F584C8}" SQLTask:SqlStatementSource="SET NOCOUNT ON;&#10;DECLARE @BatchId int = ?, @RowsInserted int = ?;&#10;INSERT INTO [dw].[Dim_Reservation_Status] ([reservation_status], [is_canceled])&#10;    SELECT DISTINCT c.[reservation_status], c.[is_canceled]&#10;    FROM [stg].[hotel_bookings_clean] c&#10;    WHERE c.[batch_id] = @BatchId&#10;      AND NOT EXISTS (SELECT 1 FROM [dw].[Dim_Reservation_Status] d WHERE d.[reservation_status] = c.[reservation_status]);&#10;SELECT @RowsInserted+@@ROWCOUNT;" SQLTask:ResultType="ResultSetType_SingleRow" SQLTask:TimeOut="0">
          <SQLTask:ParameterBinding SQLTask:ParameterName="0" SQLTask:DtsVariableName="User::BatchId" SQLTask:ParameterDirection="Input" SQLTask:DataType="3" SQLTask:ParameterSize="-1" />
          <SQLTask:ParameterBinding SQLTask:ParameterName="1" SQLTask:DtsVariableName="User::RowsInserted" SQLTask:ParameterDirection="Input" SQLTask:DataType="3" SQLTask:ParameterSize="-1" />
          <SQLTask:ResultBinding SQLTask:ResultName="0" SQLTask:DtsVariableName="User::RowsInserted" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable DTS:refId="Package\Load Agent Company" DTS:CreationName="Microsoft.ExecuteSQLTask" DTS:ExecutableType="Microsoft.ExecuteSQLTask" DTS:DTSID="{57BA4D9B-7BBE-4A9D-9EFE-ABB8C500B1BE}" DTS:ObjectName="Load Agent Company" DTS:DelayValidation="True">
      <DTS:ObjectData>
        <SQLTask:SqlTaskData SQLTask:Connection="{21CC28A4-985D-485C-9B9A-58B866F584C8}" SQLTask:SqlStatementSource="SET NOCOUNT ON;&#10;DECLARE @BatchId int = ?, @RowsInserted int = ?;&#10;INSERT INTO [dw].[Dim_Agent_Company] ([agent_id], [company_id], [has_agent_flag], [has_company_flag])&#10;    SELECT DISTINCT&#10;        c.[agent_id],&#10;        c.[company_id],&#10;        CASE WHEN c.[agent_id] &lt;&gt; '0' THEN 1 ELSE 0 END,&#10;        CASE WHEN c.[company_id] &lt;&gt; '0' THEN 1 ELSE 0 END&#10;    FROM [stg].[hotel_bookings_clean] c&#10;    WHERE c.[batch_id] = @BatchId&#10;      AND NOT EXISTS (&#10;          SELECT 1 FROM [dw].[Dim_Agent_Company] d&#10;          WHERE d.[agent_id]   = c.[agent_id]&#10;            AND d.[company_id] = c.[company_id]&#10;      );&#10;SELECT @RowsInserted+@@ROWCOUNT;" SQLTask:ResultType="ResultSetType_SingleRow" SQLTask:TimeOut="0">
          <SQLTask:ParameterBinding SQLTask:ParameterName="0" SQLTask:DtsVariableName="User::BatchId" SQLTask:ParameterDirection="Input" SQLTask:DataType="3" SQLTask:ParameterSize="-1" />
          <SQLTask:ParameterBinding SQLTask:ParameterName="1" SQLTask:DtsVariableName="User::RowsInserted" SQLTask:ParameterDirection="Input" SQLTask:DataType="3" SQLTask:ParameterSize="-1" />
          <SQLTask:ResultBinding SQLTask:ResultName="0" SQLTask:DtsVariableName="User::RowsInserted" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable DTS:refId="Package\Check Dimension Keys" DTS:CreationName="Microsoft.ExecuteSQLTask" DTS:ExecutableType="Microsoft.ExecuteSQLTask" DTS:DTSID="{0DC462FF-0C5E-4438-A9F4-1344BCEDC1B4}" DTS:ObjectName="Check Dimension Keys" DTS:DelayValidation="True">
      <DTS:ObjectData>
        <SQLTask:SqlTaskData SQLTask:Connection="{21CC28A4-985D-485C-9B9A-58B866F584C8}" SQLTask:SqlStatementSource="DECLARE @BatchId int = ?;&#10;IF EXISTS (SELECT 1 FROM stg.hotel_bookings_clean c WHERE c.batch_id=@BatchId AND (&#10;NOT EXISTS (SELECT 1 FROM dw.Dim_Hotel d WHERE d.hotel_name=c.hotel) OR&#10;NOT EXISTS (SELECT 1 FROM dw.Dim_Country d WHERE d.country_iso3=c.country) OR&#10;NOT EXISTS (SELECT 1 FROM dw.Dim_Market_Segment d WHERE d.market_segment_name=c.market_segment) OR&#10;NOT EXISTS (SELECT 1 FROM dw.Dim_Distribution_Channel d WHERE d.distribution_channel_name=c.distribution_channel) OR&#10;NOT EXISTS (SELECT 1 FROM dw.Dim_Room_Type d WHERE d.room_type_code=c.reserved_room_type) OR&#10;NOT EXISTS (SELECT 1 FROM dw.Dim_Room_Type d WHERE d.room_type_code=c.assigned_room_type) OR&#10;NOT EXISTS (SELECT 1 FROM dw.Dim_Booking_Profile d WHERE d.customer_type=c.customer_type AND d.deposit_type=c.deposit_type AND d.meal_code=c.meal AND d.is_repeated_guest=c.is_repeated_guest) OR&#10;NOT EXISTS (SELECT 1 FROM dw.Dim_Reservation_Status d WHERE d.reservation_status=c.reservation_status AND d.is_canceled=c.is_canceled) OR&#10;NOT EXISTS (SELECT 1 FROM dw.Dim_Agent_Company d WHERE d.agent_id=c.agent_id AND d.company_id=c.company_id) OR&#10;NOT EXISTS (SELECT 1 FROM dw.Dim_Date d WHERE d.full_date=c.arrival_date) OR&#10;NOT EXISTS (SELECT 1 FROM dw.Dim_Date d WHERE d.full_date=c.booking_date) OR&#10;NOT EXISTS (SELECT 1 FROM dw.Dim_Date d WHERE d.full_date=c.reservation_status_date))) THROW 50043, 'Some clean rows have missing dimension keys.',1;" SQLTask:ResultType="ResultSetType_None" SQLTask:TimeOut="0">
          <SQLTask:ParameterBinding SQLTask:ParameterName="0" SQLTask:DtsVariableName="User::BatchId" SQLTask:ParameterDirection="Input" SQLTask:DataType="3" SQLTask:ParameterSize="-1" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable DTS:refId="Package\End Batch" DTS:CreationName="Microsoft.ExecuteSQLTask" DTS:ExecutableType="Microsoft.ExecuteSQLTask" DTS:DTSID="{67FA5D15-5CC4-4D7C-B436-FFD951C2FC53}" DTS:ObjectName="End Batch" DTS:DelayValidation="True">
      <DTS:ObjectData>
        <SQLTask:SqlTaskData SQLTask:Connection="{21CC28A4-985D-485C-9B9A-58B866F584C8}" SQLTask:SqlStatementSource="DECLARE @SourceBatchId int = ?, @RunBatchId int = ?, @RowsInserted int = ?; UPDATE meta.etl_batch_log SET status='SUCCESS',end_time=SYSDATETIME(),rows_extracted=(SELECT COUNT(*) FROM stg.hotel_bookings_clean WHERE batch_id=@SourceBatchId),rows_inserted=@RowsInserted WHERE batch_id=@RunBatchId;" SQLTask:ResultType="ResultSetType_None" SQLTask:TimeOut="0">
          <SQLTask:ParameterBinding SQLTask:ParameterName="0" SQLTask:DtsVariableName="User::BatchId" SQLTask:ParameterDirection="Input" SQLTask:DataType="3" SQLTask:ParameterSize="-1" />
          <SQLTask:ParameterBinding SQLTask:ParameterName="1" SQLTask:DtsVariableName="User::RunBatchId" SQLTask:ParameterDirection="Input" SQLTask:DataType="3" SQLTask:ParameterSize="-1" />
          <SQLTask:ParameterBinding SQLTask:ParameterName="2" SQLTask:DtsVariableName="User::RowsInserted" SQLTask:ParameterDirection="Input" SQLTask:DataType="3" SQLTask:ParameterSize="-1" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
