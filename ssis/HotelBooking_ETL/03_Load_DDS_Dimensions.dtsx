    <DTS:ConnectionManager DTS:refId="Package.ConnectionManagers[SQL Server Connection]" DTS:CreationName="OLEDB" DTS:DTSID="{21CC28A4-985D-485C-9B9A-58B866F584C8}" DTS:ObjectName="SQL Server Connection">
