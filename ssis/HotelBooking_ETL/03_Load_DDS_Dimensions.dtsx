    </DTS:Variable>
    <DTS:Variable DTS:DTSID="{420F24EB-2378-5B6A-9E3E-6ECEAFD2E0BE}" DTS:EvaluateAsExpression="True" DTS:Expression="&quot;SELECT DISTINCT CAST(CASE WHEN hotel = 'Resort Hotel' THEN 'H1' ELSE 'H2' END AS VARCHAR(10)) AS hotel_code, hotel AS hotel_name, CAST(CASE WHEN hotel = 'Resort Hotel' THEN 'Algarve' ELSE 'Lisbon' END AS VARCHAR(50)) AS city, CAST('Portugal' AS VARCHAR(50)) AS country FROM stg.hotel_bookings_clean WHERE batch_id = &quot; + (DT_WSTR,12)@[User::BatchId]" DTS:Namespace="User" DTS:ObjectName="SqlDimHotel"><DTS:VariableValue DTS:DataType="8">SELECT 1 WHERE 1=0</DTS:VariableValue></DTS:Variable><DTS:Variable DTS:DTSID="{8288C5FD-B20C-5599-B058-5EC40A256E64}" DTS:Namespace="User" DTS:ObjectName="CntHotel"><DTS:VariableValue DTS:DataType="3">0</DTS:VariableValue></DTS:Variable><DTS:Variable DTS:DTSID="{2721953E-706A-5C35-BFD2-2072B6C770A8}" DTS:EvaluateAsExpression="True" DTS:Expression="&quot;SELECT DISTINCT country AS country_iso3, CAST(CASE WHEN country = 'UNK' THEN N'Unknown' ELSE country END AS NVARCHAR(100)) AS country_name, CAST(N'Unclassified' AS NVARCHAR(50)) AS region FROM stg.hotel_bookings_clean WHERE batch_id = &quot; + (DT_WSTR,12)@[User::BatchId]" DTS:Namespace="User" DTS:ObjectName="SqlDimCountry"><DTS:VariableValue DTS:DataType="8">SELECT 1 WHERE 1=0</DTS:VariableValue></DTS:Variable><DTS:Variable DTS:DTSID="{77BBCC6C-232D-5F9D-8DB3-442317A446FB}" DTS:Namespace="User" DTS:ObjectName="CntCountry"><DTS:VariableValue DTS:DataType="3">0</DTS:VariableValue></DTS:Variable><DTS:Variable DTS:DTSID="{806619E5-512B-5786-B068-CF421494AEAB}" DTS:EvaluateAsExpression="True" DTS:Expression="&quot;SELECT DISTINCT market_segment AS market_segment_name, CAST(CASE WHEN market_segment IN ('Online TA','Offline TA/TO') THEN 'Travel Agency / Operator' WHEN market_segment='Direct' THEN 'Direct' WHEN market_segment IN ('Corporate','Aviation') THEN 'B2B / Corporate' WHEN market_segment='Groups' THEN 'Groups' ELSE 'Other / Complementary' END AS VARCHAR(50)) AS segment_group FROM stg.hotel_bookings_clean WHERE batch_id = &quot; + (DT_WSTR,12)@[User::BatchId]" DTS:Namespace="User" DTS:ObjectName="SqlDimSegment"><DTS:VariableValue DTS:DataType="8">SELECT 1 WHERE 1=0</DTS:VariableValue></DTS:Variable><DTS:Variable DTS:DTSID="{BEFC1C91-D98F-5258-BB57-49CEFFEA26F5}" DTS:Namespace="User" DTS:ObjectName="CntSegment"><DTS:VariableValue DTS:DataType="3">0</DTS:VariableValue></DTS:Variable><DTS:Variable DTS:DTSID="{E7D95F4C-4784-5117-9F74-8273FDBED376}" DTS:EvaluateAsExpression="True" DTS:Expression="&quot;SELECT DISTINCT distribution_channel AS distribution_channel_name FROM stg.hotel_bookings_clean WHERE batch_id = &quot; + (DT_WSTR,12)@[User::BatchId]" DTS:Namespace="User" DTS:ObjectName="SqlDimChannel"><DTS:VariableValue DTS:DataType="8">SELECT 1 WHERE 1=0</DTS:VariableValue></DTS:Variable><DTS:Variable DTS:DTSID="{05660F99-DDE9-55BE-864A-46B6EC33C879}" DTS:Namespace="User" DTS:ObjectName="CntChannel"><DTS:VariableValue DTS:DataType="3">0</DTS:VariableValue></DTS:Variable><DTS:Variable DTS:DTSID="{F08F54C6-5DFF-5711-9DF0-68FC1C0E8540}" DTS:EvaluateAsExpression="True" DTS:Expression="&quot;SELECT DISTINCT room_type_code FROM (SELECT reserved_room_type AS room_type_code FROM stg.hotel_bookings_clean WHERE batch_id = &quot; + (DT_WSTR,12)@[User::BatchId] + &quot; UNION SELECT assigned_room_type AS room_type_code FROM stg.hotel_bookings_clean WHERE batch_id = &quot; + (DT_WSTR,12)@[User::BatchId] + &quot;) r&quot;" DTS:Namespace="User" DTS:ObjectName="SqlDimRoom"><DTS:VariableValue DTS:DataType="8">SELECT 1 WHERE 1=0</DTS:VariableValue></DTS:Variable><DTS:Variable DTS:DTSID="{937DB43E-8B95-57EC-8E24-334A8A961272}" DTS:Namespace="User" DTS:ObjectName="CntRoom"><DTS:VariableValue DTS:DataType="3">0</DTS:VariableValue></DTS:Variable><DTS:Variable DTS:DTSID="{1CA16C4A-A766-510A-8261-100AD51A0AF1}" DTS:EvaluateAsExpression="True" DTS:Expression="&quot;SELECT DISTINCT CAST(customer_type AS VARCHAR(50)) AS customer_type, CAST(deposit_type AS VARCHAR(50)) AS deposit_type, CAST(meal AS VARCHAR(20)) AS meal_code, CAST(CASE meal WHEN 'BB' THEN 'Bed &amp; Breakfast' WHEN 'HB' THEN 'Half Board (Breakfast + 1 Meal)' WHEN 'FB' THEN 'Full Board (Breakfast, Lunch, Dinner)' ELSE 'Self Catering / No Meal Package' END AS VARCHAR(100)) AS meal_description, is_repeated_guest FROM stg.hotel_bookings_clean WHERE batch_id = &quot; + (DT_WSTR,12)@[User::BatchId]" DTS:Namespace="User" DTS:ObjectName="SqlDimProfile"><DTS:VariableValue DTS:DataType="8">SELECT 1 WHERE 1=0</DTS:VariableValue></DTS:Variable><DTS:Variable DTS:DTSID="{957905F2-F0F6-5606-B0FB-9FD474793284}" DTS:Namespace="User" DTS:ObjectName="CntProfile"><DTS:VariableValue DTS:DataType="3">0</DTS:VariableValue></DTS:Variable><DTS:Variable DTS:DTSID="{C6156C54-4FF7-5478-BB42-E65F2F52BC05}" DTS:EvaluateAsExpression="True" DTS:Expression="&quot;SELECT DISTINCT reservation_status, is_canceled FROM stg.hotel_bookings_clean WHERE batch_id = &quot; + (DT_WSTR,12)@[User::BatchId]" DTS:Namespace="User" DTS:ObjectName="SqlDimStatus"><DTS:VariableValue DTS:DataType="8">SELECT 1 WHERE 1=0</DTS:VariableValue></DTS:Variable><DTS:Variable DTS:DTSID="{FF74DF5C-3081-52AC-9531-4EC6B60202DC}" DTS:Namespace="User" DTS:ObjectName="CntStatus"><DTS:VariableValue DTS:DataType="3">0</DTS:VariableValue></DTS:Variable><DTS:Variable DTS:DTSID="{6B597C06-5912-5303-8AC6-EA4118183D0B}" DTS:EvaluateAsExpression="True" DTS:Expression="&quot;SELECT DISTINCT agent_id, company_id, CAST(CASE WHEN agent_id &lt;&gt; '0' THEN 1 ELSE 0 END AS BIT) AS has_agent_flag, CAST(CASE WHEN company_id &lt;&gt; '0' THEN 1 ELSE 0 END AS BIT) AS has_company_flag FROM stg.hotel_bookings_clean WHERE batch_id = &quot; + (DT_WSTR,12)@[User::BatchId]" DTS:Namespace="User" DTS:ObjectName="SqlDimAgent"><DTS:VariableValue DTS:DataType="8">SELECT 1 WHERE 1=0</DTS:VariableValue></DTS:Variable><DTS:Variable DTS:DTSID="{A1C3A992-A19D-5B88-A473-6007EDD6ED9A}" DTS:Namespace="User" DTS:ObjectName="CntAgent"><DTS:VariableValue DTS:DataType="3">0</DTS:VariableValue></DTS:Variable><DTS:Variable DTS:DTSID="{1FF9FCC4-5CC8-5551-8895-69BDB4387E11}" DTS:Namespace="User" DTS:ObjectName="CntDate"><DTS:VariableValue DTS:DataType="3">0</DTS:VariableValue></DTS:Variable><DTS:Variable DTS:DTSID="{3AEC8848-6B9A-4171-A1AC-EBDE57FF3330}" DTS:EvaluateAsExpression="True" DTS:Expression="@[User::CntDate] + @[User::CntHotel] + @[User::CntCountry] + @[User::CntSegment] + @[User::CntChannel] + @[User::CntRoom] + @[User::CntProfile] + @[User::CntStatus] + @[User::CntAgent]" DTS:Namespace="User" DTS:ObjectName="RowsInserted"><DTS:VariableValue DTS:DataType="3">0</DTS:VariableValue></DTS:Variable>
  </DTS:Variables>
  <DTS:ConnectionManagers>
