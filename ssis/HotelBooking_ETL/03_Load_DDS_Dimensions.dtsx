    <DTS:Executable DTS:refId="Package\Check Dimension Keys" DTS:CreationName="Microsoft.ExecuteSQLTask" DTS:ExecutableType="Microsoft.ExecuteSQLTask" DTS:DTSID="{0DC462FF-0C5E-4438-A9F4-1344BCEDC1B4}" DTS:ObjectName="Check Dimension Keys" DTS:DelayValidation="True">
      <DTS:ObjectData>
        <SQLTask:SqlTaskData SQLTask:Connection="{21CC28A4-985D-485C-9B9A-58B866F584C8}" SQLTask:SqlStatementSource="DECLARE @BatchId int = ?;&#10;IF EXISTS (SELECT 1 FROM stg.hotel_bookings_clean c WHERE c.batch_id=@BatchId AND (&#10;NOT EXISTS (SELECT 1 FROM dw.Dim_Hotel d WHERE d.hotel_name=c.hotel) OR&#10;NOT EXISTS (SELECT 1 FROM dw.Dim_Country d WHERE d.country_iso3=c.country) OR&#10;NOT EXISTS (SELECT 1 FROM dw.Dim_Market_Segment d WHERE d.market_segment_name=c.market_segment) OR&#10;NOT EXISTS (SELECT 1 FROM dw.Dim_Distribution_Channel d WHERE d.distribution_channel_name=c.distribution_channel) OR&#10;NOT EXISTS (SELECT 1 FROM dw.Dim_Room_Type d WHERE d.room_type_code=c.reserved_room_type) OR&#10;NOT EXISTS (SELECT 1 FROM dw.Dim_Room_Type d WHERE d.room_type_code=c.assigned_room_type) OR&#10;NOT EXISTS (SELECT 1 FROM dw.Dim_Booking_Profile d WHERE d.customer_type=c.customer_type AND d.deposit_type=c.deposit_type AND d.meal_code=c.meal AND d.is_repeated_guest=c.is_repeated_guest) OR&#10;NOT EXISTS (SELECT 1 FROM dw.Dim_Reservation_Status d WHERE d.reservation_status=c.reservation_status AND d.is_canceled=c.is_canceled) OR&#10;NOT EXISTS (SELECT 1 FROM dw.Dim_Agent_Company d WHERE d.agent_id=c.agent_id AND d.company_id=c.company_id) OR&#10;NOT EXISTS (SELECT 1 FROM dw.Dim_Date d WHERE d.full_date=c.arrival_date) OR&#10;NOT EXISTS (SELECT 1 FROM dw.Dim_Date d WHERE d.full_date=c.booking_date) OR&#10;NOT EXISTS (SELECT 1 FROM dw.Dim_Date d WHERE d.full_date=c.reservation_status_date))) THROW 50043, 'Some clean rows have missing dimension keys.',1;" SQLTask:ResultType="ResultSetType_None" SQLTask:TimeOut="0">
          <SQLTask:ParameterBinding SQLTask:ParameterName="0" SQLTask:DtsVariableName="User::BatchId" SQLTask:ParameterDirection="Input" SQLTask:DataType="3" SQLTask:ParameterSize="-1" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
