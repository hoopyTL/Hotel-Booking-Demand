  <DTS:Executables>
    <DTS:Executable DTS:refId="Package\Get Source Batch" DTS:CreationName="Microsoft.ExecuteSQLTask" DTS:ExecutableType="Microsoft.ExecuteSQLTask" DTS:DTSID="{84A49163-A058-4F2A-87F6-52D56B8DFC3A}" DTS:ObjectName="Get Source Batch" DTS:DelayValidation="True">
      <DTS:ObjectData>
        <SQLTask:SqlTaskData SQLTask:Connection="{21CC28A4-985D-485C-9B9A-58B866F584C8}" SQLTask:SqlStatementSource="SET NOCOUNT ON;&#10;DECLARE @BatchId int = ?;&#10;IF @BatchId=0 SELECT @BatchId=MAX(l.batch_id) FROM meta.etl_batch_log l WHERE l.package_name='01_Ingest_CSV_To_RawStaging' AND l.status='SUCCESS' AND EXISTS (SELECT 1 FROM stg.hotel_bookings_clean c WHERE c.batch_id=l.batch_id);&#10;IF @BatchId IS NULL OR NOT EXISTS (SELECT 1 FROM meta.etl_batch_log WHERE batch_id=@BatchId AND package_name='01_Ingest_CSV_To_RawStaging' AND status='SUCCESS') THROW 50040, 'No valid source batch. Run packages 01 and 02 first.',1;&#10;IF NOT EXISTS (SELECT 1 FROM stg.hotel_bookings_clean WHERE batch_id=@BatchId) THROW 50041, 'Source batch has no clean rows. Run package 02 first.',1;&#10;SELECT @BatchId;" SQLTask:ResultType="ResultSetType_SingleRow" SQLTask:TimeOut="0">
          <SQLTask:ParameterBinding SQLTask:ParameterName="0" SQLTask:DtsVariableName="$Package::SourceBatchId" SQLTask:ParameterDirection="Input" SQLTask:DataType="3" SQLTask:ParameterSize="-1" />
          <SQLTask:ResultBinding SQLTask:ResultName="0" SQLTask:DtsVariableName="User::BatchId" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable DTS:refId="Package\Start Batch" DTS:CreationName="Microsoft.ExecuteSQLTask" DTS:ExecutableType="Microsoft.ExecuteSQLTask" DTS:DTSID="{EAC7305B-8B29-4A22-96AE-D0FCB2EE950A}" DTS:ObjectName="Start Batch" DTS:DelayValidation="True">
      <DTS:ObjectData>
        <SQLTask:SqlTaskData SQLTask:Connection="{21CC28A4-985D-485C-9B9A-58B866F584C8}" SQLTask:SqlStatementSource="SET NOCOUNT ON;&#10;DECLARE @SourceBatchId int = ?;&#10;INSERT INTO meta.etl_batch_log(package_name,load_type,source_file,status) SELECT '03_Load_DDS_Dimensions',load_type,source_file,'RUNNING' FROM meta.etl_batch_log WHERE batch_id=@SourceBatchId;&#10;SELECT CAST(SCOPE_IDENTITY() AS int);" SQLTask:ResultType="ResultSetType_SingleRow" SQLTask:TimeOut="0">
          <SQLTask:ParameterBinding SQLTask:ParameterName="0" SQLTask:DtsVariableName="User::BatchId" SQLTask:ParameterDirection="Input" SQLTask:DataType="3" SQLTask:ParameterSize="-1" />
          <SQLTask:ResultBinding SQLTask:ResultName="0" SQLTask:DtsVariableName="User::RunBatchId" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable DTS:refId="Package\Load Date" DTS:CreationName="Microsoft.ExecuteSQLTask" DTS:ExecutableType="Microsoft.ExecuteSQLTask" DTS:DTSID="{2FF0CB30-3972-4DFA-8045-13C44AC54F10}" DTS:ObjectName="Load Date" DTS:DelayValidation="True">
      <DTS:ObjectData>
        <SQLTask:SqlTaskData SQLTask:Connection="{21CC28A4-985D-485C-9B9A-58B866F584C8}" SQLTask:SqlStatementSource="SET NOCOUNT ON;&#10;SET LANGUAGE us_english;&#10;SET DATEFIRST 1;&#10;DECLARE @BatchId int = ?;&#10;DECLARE @StartDate date='2013-01-01',@EndDate date='2018-12-31';&#10;SELECT @StartDate=CASE WHEN MIN(d.dt)&lt;@StartDate THEN MIN(d.dt) ELSE @StartDate END,@EndDate=CASE WHEN MAX(d.dt)&gt;@EndDate THEN MAX(d.dt) ELSE @EndDate END FROM stg.hotel_bookings_clean c CROSS APPLY (VALUES(c.arrival_date),(c.booking_date),(c.reservation_status_date),(DATEADD(DAY,c.total_nights,c.arrival_date))) d(dt) WHERE c.batch_id=@BatchId;&#10;;WITH Dates AS (SELECT @StartDate AS dt UNION ALL SELECT DATEADD(DAY,1,dt) FROM Dates WHERE dt&lt;@EndDate)&#10;INSERT INTO dw.Dim_Date(date_key,full_date,day_of_month,day_of_week,day_name,is_weekend,week_of_year,month_number,month_name,quarter,year,season)&#10;SELECT CONVERT(int,CONVERT(char(8),dt,112)),dt,DAY(dt),DATEPART(WEEKDAY,dt),DATENAME(WEEKDAY,dt),CASE WHEN DATEPART(WEEKDAY,dt) IN(6,7) THEN 1 ELSE 0 END,DATEPART(ISO_WEEK,dt),MONTH(dt),DATENAME(MONTH,dt),DATEPART(QUARTER,dt),YEAR(dt),CASE WHEN MONTH(dt) IN(12,1,2) THEN 'Winter' WHEN MONTH(dt) IN(3,4,5) THEN 'Spring' WHEN MONTH(dt) IN(6,7,8) THEN 'Summer' ELSE 'Autumn' END&#10;FROM Dates WHERE NOT EXISTS (SELECT 1 FROM dw.Dim_Date d WHERE d.full_date=Dates.dt) OPTION(MAXRECURSION 0);&#10;SELECT @@ROWCOUNT;" SQLTask:ResultType="ResultSetType_SingleRow" SQLTask:TimeOut="0">
          <SQLTask:ParameterBinding SQLTask:ParameterName="0" SQLTask:DtsVariableName="User::BatchId" SQLTask:ParameterDirection="Input" SQLTask:DataType="3" SQLTask:ParameterSize="-1" />
          <SQLTask:ResultBinding SQLTask:ResultName="0" SQLTask:DtsVariableName="User::CntDate" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    
