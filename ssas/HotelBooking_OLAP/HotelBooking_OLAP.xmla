                          </xs:element>
                          <xs:element name="FullDateLabel" msprop:Description="SSAS Named Calculation" msprop:IsLogical="True" msprop:DbColumnName="FullDateLabel" msprop:ComputedColumnExpression="CONVERT(CHAR(10), [full_date], 120)" type="xs:string" minOccurs="0" />
                          <xs:element name="QuarterLabel" msprop:Description="SSAS Named Calculation" msprop:IsLogical="True" msprop:DbColumnName="QuarterLabel" msprop:ComputedColumnExpression="'Q' + CAST([quarter] AS VARCHAR(1)) + '-' + CAST([year] AS VARCHAR(4))" type="xs:string" minOccurs="0" />
                          <xs:element name="YearMonth" msprop:Description="SSAS Named Calculation" msprop:IsLogical="True" msprop:DbColumnName="YearMonth" msprop:ComputedColumnExpression="CONVERT(CHAR(7), [full_date], 120)" type="xs:string" minOccurs="0" />
                          <xs:element name="SeasonLabel" msprop:Description="SSAS Named Calculation" msprop:IsLogical="True" msprop:DbColumnName="SeasonLabel" msprop:ComputedColumnExpression="CAST([year] AS VARCHAR(4)) + ' - ' + [season]" type="xs:string" minOccurs="0" />
