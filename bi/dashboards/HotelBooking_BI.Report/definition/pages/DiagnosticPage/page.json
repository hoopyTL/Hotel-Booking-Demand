{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/page/1.3.0/schema.json",
  "name": "DiagnosticPage",
  "displayName": "2. Chi tiết (Chẩn đoán)",
  "displayOption": "FitToPage",
  "height": 720,
  "width": 1280,
  "filterConfig": {
    "filters": [
      {
        "name": "dt_filter_hotel",
        "field": {
          "Column": {
            "Expression": {
              "SourceRef": {
                "Entity": "Dim_Hotel"
              }
            },
            "Property": "hotel_name"
          }
        },
        "type": "Categorical",
        "howCreated": "Drillthrough"
      },
      {
        "name": "dt_filter_segment",
        "field": {
          "Column": {
            "Expression": {
              "SourceRef": {
                "Entity": "Dim_Market_Segment"
              }
            },
            "Property": "market_segment_name"
          }
        },
        "type": "Categorical",
        "howCreated": "Drillthrough"
      }
    ]
  },
  "pageBinding": {
    "name": "DiagnosticDrillthrough",
    "type": "Drillthrough",
    "parameters": [
      {
        "name": "param_hotel",
        "boundFilter": "dt_filter_hotel",
        "fieldExpr": {
          "Column": {
            "Expression": {
              "SourceRef": {
                "Entity": "Dim_Hotel"
              }
            },
            "Property": "hotel_name"
          }
        }
      },
      {
        "name": "param_segment",
        "boundFilter": "dt_filter_segment",
        "fieldExpr": {
          "Column": {
            "Expression": {
              "SourceRef": {
                "Entity": "Dim_Market_Segment"
              }
            },
            "Property": "market_segment_name"
          }
        }
      }
    ]
  }
}