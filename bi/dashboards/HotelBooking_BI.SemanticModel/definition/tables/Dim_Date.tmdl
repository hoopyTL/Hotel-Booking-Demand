	column 'Mùa (VN)' = SWITCH(TRUE(), 'Dim_Date'[month_number] IN {3, 4, 5}, "Mùa Xuân", 'Dim_Date'[month_number] IN {6, 7, 8}, "Mùa Hạ", 'Dim_Date'[month_number] IN {9, 10, 11}, "Mùa Thu", "Mùa Đông")
