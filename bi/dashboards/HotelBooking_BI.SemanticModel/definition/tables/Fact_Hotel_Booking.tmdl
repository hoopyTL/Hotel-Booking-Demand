	column 'Lead Time Group' =
			SWITCH(
			    TRUE(),
			    'Fact_Hotel_Booking'[lead_time] <= 7, "01. 0–7 ngày",
			    'Fact_Hotel_Booking'[lead_time] <= 30, "02. 8–30 ngày",
			    'Fact_Hotel_Booking'[lead_time] <= 90, "03. 31–90 ngày",
			    'Fact_Hotel_Booking'[lead_time] <= 180, "04. 91–180 ngày",
			    "05. Trên 180 ngày"
			)
		dataType: string
		lineageTag: ec06b56c-216e-5363-9d3d-ecb00fa7fecb
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Length of Stay Group' =
			SWITCH(
			    TRUE(),
			    'Fact_Hotel_Booking'[total_nights] = 0, "00. Trong ngày (0 đêm)",
			    'Fact_Hotel_Booking'[total_nights] <= 2, "01. Ngắn (1–2 đêm)",
			    'Fact_Hotel_Booking'[total_nights] <= 5, "02. Trung bình (3–5 đêm)",
			    'Fact_Hotel_Booking'[total_nights] <= 10, "03. Dài (6–10 đêm)",
			    "04. Dài hạn (11+ đêm)"
			)
		dataType: string
		lineageTag: 4259ab95-a10e-5088-b4c1-e39d7f381bb9
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

