# Kaggle CSV path (use the 2015-2016 / 2017 batch file when simulating incremental loads)
HOTEL_BOOKINGS_CSV=data/raw/hotel_bookings.csv
HOTEL_BOOKINGS_LOAD_TYPE=FULL

# SQLAlchemy URL for the target SQL Server. URL-encode special characters in credentials.
HOTELBOOKING_SQLALCHEMY_URL=mssql+pyodbc://USER:PASSWORD@localhost:1433/HotelBooking_DW?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes

# dbt SQL Server profile. Keep secrets in this untracked .env file.
DBT_TARGET=dev
DBT_DRIVER="ODBC Driver 18 for SQL Server"
DBT_SERVER=localhost
DBT_PORT=1433
DBT_DATABASE=HotelBooking_DW
DBT_USER=sa
DBT_PASSWORD=change-me
DBT_TRUST_CERT=true

# AI summary app
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
BI_SCHEMA=bi
